#!/bin/sh
# Git supplies: local_ref local_oid remote_ref remote_oid, one update per line.
# Inspect the destination: this also blocks HEAD:main and deletion of main.
while read -r local_ref local_oid remote_ref remote_oid
do
    if [ "$remote_ref" = "refs/heads/main" ]; then
        printf '%s\n' 'ERROR: Direct push to main is forbidden.' >&2
        printf '%s\n' 'Please push a feature branch and create a Pull Request.' >&2
        exit 1
    fi
done
exit 0
