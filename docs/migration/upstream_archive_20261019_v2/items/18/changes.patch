diff --git a/fpga/camera_hil/evidence/cdc-2020.1/review-cdc-executed.tcl b/fpga/camera_hil/evidence/cdc-2020.1/review-cdc-executed.tcl
new file mode 100644
index 0000000000000000000000000000000000000000..51eaeec2a76b1a72a3f6158d40c81e8276e61f47
--- /dev/null
+++ b/fpga/camera_hil/evidence/cdc-2020.1/review-cdc-executed.tcl
@@ -0,0 +1,35 @@
+# Read-only inspection of the actual fresh routed checkpoint; no design changes.
+if {[llength $argv] != 2} {error "usage: review_cdc.tcl routed.dcp NEW_RESULT"}
+lassign $argv dcp out
+if {[file exists $out]} {error "refusing existing result"}
+file mkdir $out
+open_checkpoint $dcp
+set f [open [file join $out cdc_physical.txt] w]
+set serdes [get_cells -hier -filter {REF_NAME == ISERDESE3}]
+if {[llength $serdes] != 16} {error "Expected original 16 ISERDESE3 lanes"}
+foreach c $serdes {
+    set clk [get_nets -segments -of_objects [get_pins $c/CLK]]
+    set clkb [get_nets -segments -of_objects [get_pins $c/CLK_B]]
+    puts $f "OBSERVED=$c CLK=$clk CLK_B=$clkb INVERT=[get_property IS_CLK_B_INVERTED $c]"
+    if {[lsort $clk] ne [lsort $clkb] || [get_property IS_CLK_B_INVERTED $c] ni {1 1'b1}} {
+        error "SERDES must use one clock net with local inversion: $c"
+    }
+    puts $f "SERDES=$c CLK_NET=$clk CLK_B_NET=$clkb LOCAL_INVERT=[get_property IS_CLK_B_INVERTED $c] LOC=[get_property LOC $c]"
+}
+foreach pattern {*clkdet/heartbeat_reg *clkdet/missing_ref_reg *gate/write_ready_reg *delay_reference/inst/qualified_ref_reg*} {
+    set cells [get_cells -hier -filter "NAME =~ $pattern"]
+    puts $f "REGISTER_PATTERN=$pattern COUNT=[llength $cells] CELLS=$cells"
+    foreach c $cells {puts $f "FF=$c TYPE=[get_property REF_NAME $c] LOC=[get_property LOC $c]"}
+}
+foreach c [get_cells -hier -filter {REF_NAME == BUFGCE_DIV}] {
+    set pins [get_pins -leaf -of_objects [get_nets -segments -of_objects [get_pins $c/CLR]] -filter {DIRECTION == OUT}]
+    puts $f "DIVIDER=$c CLR_DRIVER=$pins"
+    if {![string match *reset_divider/arststages_ff_reg* $pins]} {error "Divider CLR lacks actual undivided-clock reset synchronizer"}
+}
+foreach c [get_cells -hier -filter {NAME =~ *arststages_ff_reg* || NAME =~ *syncstages_ff_reg*}] {
+    puts $f "CDC_FF=$c CLOCK=[get_clocks -of_objects [get_pins $c/C]] ASYNC_REG=[get_property ASYNC_REG $c]"
+}
+close $f
+report_timing -delay_type min -from $serdes -max_paths 16 -file [file join $out serdes_hold.rpt]
+report_clock_interaction -file [file join $out clock_interaction.rpt]
+exit
diff --git a/fpga/camera_hil/evidence/cdc-2020.1/review-reference-executed.tcl b/fpga/camera_hil/evidence/cdc-2020.1/review-reference-executed.tcl
new file mode 100644
index 0000000000000000000000000000000000000000..ecabd3a888bd4f4f8d8cfd923a86394998ceb7fd
--- /dev/null
+++ b/fpga/camera_hil/evidence/cdc-2020.1/review-reference-executed.tcl
@@ -0,0 +1,36 @@
+# Physical inspection of the NEW completed implementation; no implementation edit.
+if {[llength $argv] != 2} {error "usage: review_impl.tcl routed.dcp NEW_RESULT"}
+lassign $argv dcp out
+if {[file exists $out]} {error "result already exists"}
+file mkdir $out
+open_checkpoint $dcp
+set f [open [file join $out physical_reference.txt] w]
+set m [get_cells -hier -filter {REF_NAME =~ MMCME4*}]
+if {[llength $m] != 1 || ![string match *delay_reference* $m]} {error "Expected one shared MMCM"}
+puts $f "MMCM=$m M=[get_property CLKFBOUT_MULT_F $m] D=[get_property DIVCLK_DIVIDE $m] O=[get_property CLKOUT0_DIVIDE_F $m] LOC=[get_property LOC $m]"
+set controls [get_cells -hier -filter {REF_NAME == IDELAYCTRL}]
+set clocks {}
+foreach c $controls {
+    set clk [get_clocks -of_objects [get_pins $c/REFCLK]]
+    if {[llength $clk] != 1} {error "Controller has ambiguous/no reference clock: $c"}
+    lappend clocks $clk
+    set reset [get_nets -segments -of_objects [get_pins $c/RST]]
+    set driver [get_pins -leaf -of_objects $reset -filter {DIRECTION == OUT}]
+    puts $f "CTRL=$c LOC=[get_property LOC $c] CLOCK=$clk PERIOD=[get_property PERIOD $clk] RST_DRIVER=$driver"
+}
+if {[llength [lsort -unique $clocks]] != 1} {error "Controllers do not share one actual reference clock"}
+foreach c [get_cells -hier -filter {REF_NAME == IDELAYE3}] {
+    set reset [get_nets -segments -of_objects [get_pins $c/RST]]
+    set driver [get_pins -leaf -of_objects $reset -filter {DIRECTION == OUT}]
+    puts $f "DELAY=$c LOC=[get_property LOC $c] FORMAT=[get_property DELAY_FORMAT $c] REFCLK_MHZ=[get_property REFCLK_FREQUENCY $c] VALUE=[get_property DELAY_VALUE $c] RST_DRIVER=$driver"
+}
+puts $f "CONTROLLER_COUNT=[llength $controls]"
+foreach i {0 1 2 3} {
+    set pin [get_pins design_1_i/delay_reference/inst/ready$i]
+    set drivers [get_pins -leaf -of_objects [get_nets -segments -of_objects $pin] -filter {DIRECTION == OUT}]
+    puts $f "CSI_RDY_RETURN_$i=$drivers"
+    puts $f "CSI_RDY_STARTPOINTS_$i=[all_fanin -flat -startpoints_only -to $pin]"
+}
+close $f
+report_clock_interaction -file [file join $out clock_interaction.rpt]
+exit
