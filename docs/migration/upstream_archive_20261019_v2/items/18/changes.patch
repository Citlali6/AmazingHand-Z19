@@ -0,0 +1,167 @@
+# Explicit experimental Vivado 2020.1 reconstruction
+
+Authorized by [Issue #17's follow-up](https://github.com/Tom-mr33/AmazingHand-based-on-FPGA/issues/17#issuecomment-6246288827).
+This route recreates the design in a **new** project from the original BD's
+configuration; it does not open an unsupported old BD and change its version,
+run upgrade_ip, overwrite any original XCI/BD, or alter the strict 2020.2 entry.
+It uses only the installed Vivado/Vitis 2020.1. No new tool installation is needed.
+
+```powershell
+python fpga/camera_hil/experimental_2020_1/prepare.py --output F:/ah-camera-hil-2020.1-new --stage impl --repair-csi
+& F:/Xilinx/Vivado/2020.1/bin/vivado.bat -mode batch -nojournal -log F:/ah-camera-hil-2020.1-new/vivado.log -source F:/ah-camera-hil-2020.1-new/rebuild.tcl
+python fpga/camera_hil/audit.py --build F:/ah-camera-hil-2020.1-new
+```
+
+`probe` stops after actual catalog/property restoration and IP status. `validate`
+restores the entire topology, adds AHIL, invokes real validate_bd_design and
+generates output products. `synth` and `impl` continue to their respective runs.
+Output destinations must not exist; source snapshots, generated projects and
+reports stay there. `reconstruction.json` lists every converted block and the
+exact generated Tcl hash. It is not a completion certificate. `validated.txt`
+is written by Vivado only after validation returns successfully.
+
+The 2020.1 catalog contains all original IP VLNVs and the supplied ALINX CSI and
+Digilent Bayer/Gamma sources. All 1,012 archived PS properties are accepted by
+2020.1 without removing a property. The unflagged reconstruction preserves every
+original top-level block/connection/address and appends M11/AHIL. `--repair-csi`
+also adds the explicitly audited shared-reference block and private scalar
+calibration ports described below; original endpoint groups remain connected.
+Native XCI/BD
+serialization still differs from 2020.2; these are explicitly audited:
+
+- PS `PSU__PROTECTION__SLAVES` adds the FPD_GPV and CCI_GPV descriptors. Original
+  entries/flags remain unchanged. New XSA PS initialization must never run on
+  the existing Linux: the added metadata is not board validated.
+- Address-space serialization includes 40-bit/1T PS and 64-bit/16E VDMA metadata;
+  all mapped and excluded segments retain their original values.
+- Native XCI instance names change. Metadata of disabled PS AXI interfaces and
+  the unconnected IRQ0 differs; connected HPM0/HP1 and IRQ1 stay unchanged.
+- The 2020.1 xlconcat schema omits nonexistent input slots >=32; the six used
+  inputs are unchanged. AXI-IIC advertises two outstanding accesses instead of
+  one; its core model parameters are unchanged, and camera 0 uses PS I2C0.
+- Metadata of other unconnected/disabled interfaces differs. No changed active
+  image pipeline model parameter is accepted. `audit_xci.py` rejects differences
+  outside the enumerated cases, in addition to the original BD semantic audit.
+
+The native XCI implementations require real synthesis/implementation and later
+independent board acceptance. Passing a catalog/property audit, BD validation or
+even implementation does not establish real sensor capture in this profile.
+The existing camera/HIL standalone profiles and original camera files remain
+the recovery references. No board operations are part of this experiment, and
+Issue #20 vision-to-control integration is outside its authorized scope.
+
+After an implementation truly passes the unchanged timing/DRC/coverage and
+bit/XSA gates, `package_linux.py` recognizes `experimental-camera-hil-2020.1`
+and requires matching 2020.1 reports; all firmware hashes and rollback checks
+remain mandatory. New firmware still needs separate current field approval.
+
+## P0 private CSI repair
+
+The [P0 authorization](https://github.com/Tom-mr33/AmazingHand-based-on-FPGA/issues/17#issuecomment-6246782620)
+adds `--repair-csi`. Omitting that flag reproduces the earlier reconstruction.
+The current v3 flagged path makes seven exact file transformations only in the
+copied CSI IP: six HDL files plus component.xml scalar ports/XPM metadata. `csi_patch.py` records
+original/patched SHA256 and the auditor recomputes every expected byte from
+the untouched archive. A single new `delay_reference` module is shared by all
+four CSI instances; all existing connections, addresses and PS parameters stay.
+
+- Real MMCME4_BASE M=6/D=1/O=4, BUFG feedback/output: unchanged measured PL0
+  200.703980 MHz -> VCO 1204.223880 MHz -> IDELAY reference 301.055970 MHz.
+  The original PL0 clock detector and AXI/stream domains remain on PL0.
+- TIME/FIXED IDELAYE3 retains delay=20 ps and EN_VTC=1; REFCLK_FREQUENCY
+  matches 301.055970. IDELAY reset now uses the common I/O reset instead of
+  constant zero. Original IDELAYCTRL SIM_DEVICE=ULTRASCALE is correct for US+.
+- Lock loss/reset asserts immediately; three reference-domain stages release
+  the sequencer. All I/O primitive resets release together after 8 ref cycles,
+  then all IDELAYCTRL resets together 32 ref cycles later (>106 ns).
+  Primitive initial reset release does not require a sensor/byte clock or RDY.
+  All four controller RDYs are synchronized in the common reference domain;
+  each application separately synchronizes this condition and waits at least
+  64 of its own byte clocks before accepting data. An absent camera therefore
+  does not prevent the reference-domain calibration sequence from running.
+- The v3 structural follow-up replaces clock-level sampling with a real byte-domain
+  heartbeat FF, three-stage XPM transfer to PL0, registered missing-clock state,
+  and a three-stage XPM asynchronous-assert/synchronous-release reset back to byte.
+  The timeout is 201 PL0 cycles after the last observed heartbeat transition
+  (plus observation latency), approximately 1 us, and handles stopped-high/low clocks.
+- Each controller group's RDY is separately synchronized into the reference domain,
+  then qualification is registered there before crossing to byte through one XPM
+  reset. Application logic waits 64 byte cycles; the same local link reset flushes
+  the FIFO after calibration/clock failure. No duplicate reset synchronizer can
+  release application and FIFO independently in the same domain.
+- FIFO write-ready originates in a real byte-domain register and crosses through
+  three XPM stages. Both actual FIFO busy outputs, full/empty and stream reset
+  gate transfers; AXIS valid no longer depends on sink ready. Original FIFO
+  mode/depth/width/memory selection remain unchanged.
+- BUFGCE_DIV clear releases through an XPM reset clocked by the undivided HS
+  clock. ISERDESE3 CLK and CLK_B use the same physical clock net with local
+  IS_CLK_B_INVERTED=1 per UG949. This is a real primitive connection/property
+  change, not a hold exception. Routed hold and CDC reports remain mandatory.
+- `mipi_nominal.xdc` models only the nominal source clocks derived from the
+  local FL0214 REV1.0 manual and fl0214_2018-3-14 schematic p4
+  (X1 OSC25MHz -> U12 5PB1102PGGI -> both CSI MCLK) and Sony IMX214 Software Reference
+  0.0.6 pp47-49 plus existing sensor_table.h registers: OPCK=25/8*110 MHz,
+  DCK=OPCK/2/1=171.875 MHz. It supplies no guessed external delays and no broad
+  clock-group/false-path exceptions. Sensor/bridge/PCB/oscillator qualification
+  is a separate signoff requirement; the nominal model is not a field reading.
+- `fix_netlist.tcl` proves four VDMA URAM288 NONE/NONE instances and ties only
+  disconnected cascade inputs to GND, leaving already grounded inputs alone.
+  It checks actual connections and driver types. It considers only proved
+  unused FIFO status outputs for no-load cleanup; DONT_TOUCH/security-protected
+  vendor nets are retained. No VDMA mode/depth/width, DRC severity or gate changes.
+
+The clock/reset requirements are from [DS925 I/O delay characteristics](https://docs.amd.com/r/en-US/ds925-zynq-ultrascale-plus/Input/Output-Delay-Switching-Characteristics),
+[DS925 MMCM characteristics](https://docs.amd.com/r/en-US/ds925-zynq-ultrascale-plus/MMCM-Switching-Characteristics)
+and [UG571 v1.16 pp188-194](https://docs.amd.com/api/khub/documents/kFbaUC5HGcXyGNauhgU6Gw/content).
+The local Sony/module manuals are not redistributed here. The older archived
+camera, validated firmware and strict entry are never patched by this option.
+
+
+## Structural CDC fault tests and signoff
+
+Authorized by [the structural P0 follow-up](https://github.com/Tom-mr33/AmazingHand-based-on-FPGA/issues/17#issuecomment-6247649307).
+The exact patch ledger is version 3 and rejects any unreviewed private source
+change. `csi_clock_detector.vhd`, `csi_cdc_helpers.v` and `structural_patch.py`
+are reproducible private transformations, not edits to the original camera IP.
+Vendor XPM instances supply their own narrowly scoped first-stage CDC constraints;
+no clock groups, broad false paths or manual CDC exceptions were added.
+
+```powershell
+python fpga/camera_hil/experimental_2020_1/run_local_tests.py --output F:/ah-camera-hil-faults-new
+python fpga/camera_hil/experimental_2020_1/prepare.py --output F:/ah-camera-hil-local-new --stage impl --repair-csi
+& F:/Xilinx/Vivado/2020.1/bin/vivado.bat -mode batch -nojournal -log F:/ah-camera-hil-local-new/local.log -source fpga/camera_hil/experimental_2020_1/local_verify.tcl -tclargs F:/ah-camera-hil-local-new F:/ah-camera-hil-local-synth-new
+```
+
+These tests inject initial reset, actual MMCM model loss/relock, delayed/all-RDY
+qualification, byte clock stop high/low and restart, FIFO busy/full/empty,
+backpressure, stream reset and stale-data flushing with the actual vendor FIFO.
+They do not simulate sensor electrical margins or establish live image capture.
+The actual FIFO uses the original production-default SIM_ASSERT_CHK=0 with
+independent overflow/underflow, busy and data checks. An additional diagnostic
+SIM_ASSERT_CHK=1 run emitted vendor S4/S5/S6/S7 errors and is retained separately;
+it is **not** described as a clean vendor assertion run. The S5 diagnostic is a
+one-cycle cross-domain read-pointer equality check despite its sleep wording. S4 remains an
+unresolved diagnostic, bounded by the independent busy/empty/flush self-checks.
+
+SERDES clock guidance: [UG949 ISERDESE3/IDDRE1 clocking](https://docs.amd.com/r/2021.2-English/ug949-vivado-design-methodology/ISERDESE3-and-IDDRE1-Clocking)
+and UG571 v1.16 pp190-191. No internal divide-clock fabric connection, arbitrary
+input delay, FIFO mode change or clock-frequency reduction was used.
+
+The packaging gate also requires a genuine nonnegative bus-skew report for
+XPM Gray-pointer constraints, alongside zero Critical CDC, complete timing
+coverage, timing closure, zero DRC and source/topology/bit-XSA matching.
+The [current full-implementation facts](../evidence/cdc-2020.1/README.md) show
+modeled timing met and whole-design Critical/Warning CDC zero; external timing,
+RTSTAT and frame-protocol acceptance still prevent deployment. The
+older P0 evidence remains immutable historical output.
+
+
+A remaining protocol risk is deliberately not hidden by the local FIFO tests:
+the approximately1us missing-clock threshold can also be reached during a normal
+noncontinuous MIPI HS/frame gap. Flushing on link reset may discard queued tail
+pixels under downstream backpressure. The four-word FIFO test does not establish
+complete-frame behavior. Normal HS gaps, TUSER/TLAST preservation, incomplete-frame
+handling and VDMA recovery at real frame boundaries require a focused protocol
+simulation and later separately authorized same-bit sensor test. These remain
+functional acceptance blockers even if internal timing/CDC close. No current
+claim is made that the private camera capture profile has been board validated.
diff --git a/fpga/camera_hil/experimental_2020_1/audit_xci.py b/fpga/camera_hil/experimental_2020_1/audit_xci.py
new file mode 100644
index 0000000000000000000000000000000000000000..906635a8fe9c089cbc8b76f36c3ffae738a47e28
--- /dev/null
+++ b/fpga/camera_hil/experimental_2020_1/audit_xci.py
@@ -0,0 +1,74 @@
+"""Compare generated 2020.1 XCI parameters with archived camera XCI, including inactive metadata."""
+import json
+from pathlib import Path
+import re
+import xml.etree.ElementTree as ET
+
+NS = '{http://www.spiritconsortium.org/XMLSchema/SPIRIT/1685-2009}'
+
+
+def values(path):
+    root = ET.parse(path).getroot()
+    return {node.attrib[NS + 'referenceId']: node.text or ''
+            for node in root.iter(NS + 'configurableElementValue')}
+
+
+def audit_xci(camera, build, old, new):
+    original = camera / 'project/mipi_dp.srcs/sources_1/bd/design_1'
+    generated = build / 'vivado/mipi_dp.srcs/sources_1/bd/design_1'
+    used = {p for net in old['interface_nets'].values() for p in net['interface_ports']}
+    used.update(p for net in old['nets'].values() for p in net['ports'])
+    report = {}
+    for name, component in old['components'].items():
+        if ':module_ref:' in component['vlnv']:
+            continue
+        a = next(original.rglob(component['xci_name'] + '.xci'))
+        b = next(generated.rglob(new['components'][name]['xci_name'] + '.xci'))
+        x, y = values(a), values(b)
+        differences = []
+        for key in sorted(set(x) | set(y)):
+            if not key.startswith(('PARAM_VALUE.', 'MODELPARAM_VALUE.', 'BUSIFPARAM_VALUE.')) or x.get(key) == y.get(key):
+                continue
+            before, after = x.get(key), y.get(key)
+            reason = None
+            if key in ['PARAM_VALUE.Component_Name', 'MODELPARAM_VALUE.TLM_COMPONENT_NAME']:
+                if after == b.stem:
+                    reason = 'regenerated instance name; no hardware parameter change'
+            elif name == 'ps8_0_axi_periph' and key == 'PARAM_VALUE.NUM_MI' and (before, after) == ('11', '12'):
+                reason = 'authorized additional M11 AHIL destination'
+            elif name == 'zynq_ultra_ps_e_0':
+                parameter = key.removeprefix('PARAM_VALUE.')
+                if parameter == 'PSU__PROTECTION__SLAVES':
+                    extra = {'FPD;FPD_GPV;FD700000;FD7FFFFF;1', 'FPD;CCI_GPV;FD6E0000;FD6EFFFF;1'}
+                    if set(after.replace('\n', '').split('|')) == set(before.replace('\n', '').split('|')) | extra:
+                        reason = '2020.1 generated protection metadata; new PS initialization forbidden'
+                inactive = {'PSU__M_AXI_GP1__FREQMHZ': ('PSU__USE__M_AXI_GP1', '200.0', '10'),
+                            'PSU__M_AXI_GP2__FREQMHZ': ('PSU__USE__M_AXI_GP2', '100.0', '10'),
+                            'PSU__S_AXI_GP0__FREQMHZ': ('PSU__USE__S_AXI_GP0', '200.0', '10'),
+                            'PSU__S_AXI_GP2__FREQMHZ': ('PSU__USE__S_AXI_GP2', '200.0', '10'),
+                            'PSU__S_AXI_GP4__FREQMHZ': ('PSU__USE__S_AXI_GP4', '200.0', '10'),
+                            'PSU__S_AXI_GP5__FREQMHZ': ('PSU__USE__S_AXI_GP5', '200.0', '10'),
+                            'PSU__SAXIGP0__DATA_WIDTH': ('PSU__USE__S_AXI_GP0', '32', '128')}
+                if parameter in inactive:
+                    enable, expected_a, expected_b = inactive[parameter]
+                    if x['PARAM_VALUE.' + enable] == y['PARAM_VALUE.' + enable] == '0' and (before, after) == (expected_a, expected_b):
+                        reason = 'metadata of a disabled PS AXI interface'
+                if parameter == 'PSU__NUM_F2P0__INTR__INPUTS' and (before, after) == ('7', '1') and name + '/pl_ps_irq0' not in used:
+                    reason = 'unused/unconnected IRQ0 input width; connected IRQ1 unchanged'
+            if name == 'xlconcat_3' and re.fullmatch(r'(?:MODEL)?PARAM_VALUE.IN(?:3[2-9]|[4-9][0-9]|1[01][0-9]|12[0-7])_WIDTH', key) and (before, after) == ('1', None):
+                if x['PARAM_VALUE.NUM_PORTS'] == y['PARAM_VALUE.NUM_PORTS'] == '6':
+                    reason = 'removed metadata for nonexistent inputs >=32; six active inputs unchanged'
+            if key.startswith('BUSIFPARAM_VALUE.'):
+                interface = key.split('.')[1]
+                if name + '/' + interface not in used:
+                    reason = 'unconnected/disabled interface descriptor; no connected bus change'
+                elif name in ['axi_iic_0', 'axi_iic_1'] and key in [
+                        'BUSIFPARAM_VALUE.S_AXI.NUM_READ_OUTSTANDING',
+                        'BUSIFPARAM_VALUE.S_AXI.NUM_WRITE_OUTSTANDING'] and (before, after) == ('1', '2'):
+                    reason = '2020.1 AXI-IIC outstanding capability metadata; core model parameters unchanged'
+            if reason is None:
+                raise ValueError('unreviewed 2020.1 XCI difference: %s/%s %r -> %r' %
+                                 (name, key, str(before)[:120], str(after)[:120]))
+            differences.append(dict(parameter=key, original=before, native=after, reason=reason))
+        report[name] = dict(original=str(a), native=str(b), vlnv=component['vlnv'], differences=differences)
+    return report
diff --git a/fpga/camera_hil/experimental_2020_1/csi_cdc_helpers.v b/fpga/camera_hil/experimental_2020_1/csi_cdc_helpers.v
new file mode 100644
index 0000000000000000000000000000000000000000..52b6726e3be013f09482d35c1f5df36527d470c8
--- /dev/null
+++ b/fpga/camera_hil/experimental_2020_1/csi_cdc_helpers.v
@@ -0,0 +1,36 @@
+`timescale 1ns/1ps
+// Private helpers use vendor XPM CDCs and their instance-scoped constraints.
+module csi_application_gate(input wire byte_clk, input wire qualified,
+                            output wire ready, output wire reset_byte);
+  xpm_cdc_async_rst #(.DEST_SYNC_FF(3),.INIT_SYNC_FF(1),.RST_ACTIVE_HIGH(1))
+    qualification_reset(.src_arst(!qualified),.dest_clk(byte_clk),.dest_arst(reset_byte));
+  reg [6:0] count = 0;
+  reg ready_q = 0;
+  always @(posedge byte_clk) begin
+    if(reset_byte) begin count<=0; ready_q<=0; end
+    else if(count<64) begin count<=count+1; ready_q<=0; end
+    else ready_q<=1;
+  end
+  // Immediate invalidation from the XPM async assertion, synchronous release.
+  assign ready = ready_q && !reset_byte;
+endmodule
+
+module csi_fifo_gate(input wire byte_clk, stream_clk,
+  input wire link_reset, stream_reset_n,
+  input wire wr_busy, rd_busy, full, empty, source_valid, sink_ready,
+  output wire fifo_reset, wr_en, rd_en, out_valid);
+  // Reuse the actual byte-domain link reset: qualification, clock failure and
+  // 64-cycle settling. Flush stale FIFO data after any link failure.
+  // No second ref-to-byte reset synchronizer or independent release.
+  assign fifo_reset = link_reset;
+  reg write_ready = 0;
+  always @(posedge byte_clk or posedge link_reset)
+    if(link_reset) write_ready<=0;
+    else write_ready <= !fifo_reset && !wr_busy;
+  wire read_qualified;
+  xpm_cdc_single #(.DEST_SYNC_FF(3),.INIT_SYNC_FF(1),.SRC_INPUT_REG(0))
+    ready_transfer(.src_clk(1'b0),.src_in(write_ready),.dest_clk(stream_clk),.dest_out(read_qualified));
+  assign wr_en = source_valid && write_ready && !wr_busy && !full;
+  assign out_valid = stream_reset_n && read_qualified && !rd_busy && !empty;
+  assign rd_en = sink_ready && out_valid;
+endmodule
diff --git a/fpga/camera_hil/experimental_2020_1/csi_clock_detector.vhd b/fpga/camera_hil/experimental_2020_1/csi_clock_detector.vhd
new file mode 100644
index 0000000000000000000000000000000000000000..69d60013ab36b1ec19da17aa2b6fe2686e122528
--- /dev/null
+++ b/fpga/camera_hil/experimental_2020_1/csi_clock_detector.vhd
@@ -0,0 +1,43 @@
+-- Private structural replacement; original MIT notice is retained in source.
+library IEEE;
+use IEEE.STD_LOGIC_1164.ALL;
+use IEEE.NUMERIC_STD.ALL;
+library xpm;
+use xpm.vcomponents.all;
+entity csi_rx_clock_det is
+  port(ref_clock, ext_clock, enable, reset_in : in std_logic;
+       reset_out : out std_logic);
+end csi_rx_clock_det;
+architecture structural of csi_rx_clock_det is
+  signal heartbeat : std_logic := '0';
+  signal heartbeat_ref, heartbeat_last : std_logic := '0';
+  signal missing_count : unsigned(7 downto 0) := (others => '1');
+  signal missing_ref : std_logic := '1';
+begin
+  -- Real source-domain FF, not an unregistered clock net used as CDC data.
+  process(ext_clock) begin
+    if rising_edge(ext_clock) then heartbeat <= not heartbeat; end if;
+  end process;
+  heartbeat_sync : xpm_cdc_single
+    generic map(DEST_SYNC_FF=>3, INIT_SYNC_FF=>1, SRC_INPUT_REG=>0, SIM_ASSERT_CHK=>0)
+    port map(src_clk=>'0', src_in=>heartbeat, dest_clk=>ref_clock, dest_out=>heartbeat_ref);
+  process(ref_clock) begin
+    if rising_edge(ref_clock) then
+      heartbeat_last <= heartbeat_ref;
+      if reset_in='1' or enable='0' then
+        missing_count <= (others=>'1'); missing_ref <= '1';
+      elsif heartbeat_ref /= heartbeat_last then
+        missing_count <= (others=>'0'); missing_ref <= '0';
+      elsif missing_count < 200 then
+        missing_count <= missing_count + 1;
+      else
+        missing_ref <= '1';
+      end if;
+    end if;
+  end process;
+  -- Missing clocks ASSERT reset even when byte clock has stopped high or low.
+  -- Restoration releases only through three actual destination clock edges.
+  reset_transfer : xpm_cdc_async_rst
+    generic map(DEST_SYNC_FF=>3, INIT_SYNC_FF=>1, RST_ACTIVE_HIGH=>1)
+    port map(src_arst=>missing_ref, dest_clk=>ext_clock, dest_arst=>reset_out);
+end structural;
diff --git a/fpga/camera_hil/experimental_2020_1/csi_delay_reference.v b/fpga/camera_hil/experimental_2020_1/csi_delay_reference.v
new file mode 100644
index 0000000000000000000000000000000000000000..89d61f0c7a431e21bcf11bb99644933cd7745858
--- /dev/null
+++ b/fpga/camera_hil/experimental_2020_1/csi_delay_reference.v
@@ -0,0 +1,48 @@
+`timescale 1ns/1ps
+// Experimental ZU19EG-only delay reference. PS/AXI/stream clocks stay unchanged.
+// DS925: UltraScale+ IDELAYCTRL REFCLK 300..800 MHz, reset >=52 ns.
+// Actual preserved PL0 200.703980 MHz * 6 / 4 = 301.055970 MHz.
+// MMCM VCO=1204.223880 MHz; DS925 -2 MMCM VCO range 800..1600 MHz.
+module csi_delay_reference(input wire clk_pl0, input wire reset,
+                           input wire ready0, ready1, ready2, ready3,
+                           output wire refclk, output wire io_reset,
+                           output wire delay_reset, output wire all_ready);
+  wire feedback_raw, feedback, ref_raw, locked;
+  MMCME4_BASE #(.CLKIN1_PERIOD(4.982462231192426),
+    .CLKFBOUT_MULT_F(6.0), .DIVCLK_DIVIDE(1), .CLKOUT0_DIVIDE_F(4.0),
+    .BANDWIDTH("OPTIMIZED"), .STARTUP_WAIT("FALSE")) ref_mmcm (
+    .CLKIN1(clk_pl0), .CLKFBIN(feedback), .CLKFBOUT(feedback_raw),
+    .CLKOUT0(ref_raw), .LOCKED(locked), .RST(reset), .PWRDWN(1'b0),
+    .CLKFBOUTB(), .CLKOUT0B(), .CLKOUT1(), .CLKOUT1B(), .CLKOUT2(),
+    .CLKOUT2B(), .CLKOUT3(), .CLKOUT3B(), .CLKOUT4(), .CLKOUT5(), .CLKOUT6());
+  BUFG feedback_buf(.I(feedback_raw), .O(feedback));
+  BUFG reference_buf(.I(ref_raw), .O(refclk));
+  // Immediate assertion on reset/lock loss; three-stage synchronous release.
+  (* ASYNC_REG="TRUE", SHREG_EXTRACT="NO" *) reg [2:0] lock_release = 0;
+  reg [39:0] reset_hold = 40'hffffffffff;
+  always @(posedge refclk or posedge reset or negedge locked)
+    if (reset || !locked) lock_release <= 0;
+    else lock_release <= {lock_release[1:0], 1'b1};
+  always @(posedge refclk or posedge reset or negedge locked)
+    if (reset || !locked) reset_hold <= 40'hffffffffff;
+    else if (!lock_release[2]) reset_hold <= 40'hffffffffff;
+    else reset_hold <= {reset_hold[38:0], 1'b0};
+  // Shared across ALL CSI instances/banks; no dependency on sensor clocks.
+  // IO primitives release after 8 reference cycles; CTRL 32 cycles later.
+  assign io_reset = reset_hold[7];
+  assign delay_reset = reset_hold[39];
+  wire [3:0] ready_ref;
+  xpm_cdc_single #(.DEST_SYNC_FF(3),.INIT_SYNC_FF(1),.SRC_INPUT_REG(0))
+    rdy0_sync(.src_clk(1'b0),.src_in(ready0),.dest_clk(refclk),.dest_out(ready_ref[0]));
+  xpm_cdc_single #(.DEST_SYNC_FF(3),.INIT_SYNC_FF(1),.SRC_INPUT_REG(0))
+    rdy1_sync(.src_clk(1'b0),.src_in(ready1),.dest_clk(refclk),.dest_out(ready_ref[1]));
+  xpm_cdc_single #(.DEST_SYNC_FF(3),.INIT_SYNC_FF(1),.SRC_INPUT_REG(0))
+    rdy2_sync(.src_clk(1'b0),.src_in(ready2),.dest_clk(refclk),.dest_out(ready_ref[2]));
+  xpm_cdc_single #(.DEST_SYNC_FF(3),.INIT_SYNC_FF(1),.SRC_INPUT_REG(0))
+    rdy3_sync(.src_clk(1'b0),.src_in(ready3),.dest_clk(refclk),.dest_out(ready_ref[3]));
+  reg qualified_ref = 0;
+  always @(posedge refclk or posedge io_reset)
+    if(io_reset) qualified_ref<=0;
+    else qualified_ref<= &ready_ref && !delay_reset;
+  assign all_ready = qualified_ref;
+endmodule
diff --git a/fpga/camera_hil/experimental_2020_1/csi_patch.py b/fpga/camera_hil/experimental_2020_1/csi_patch.py
new file mode 100644
index 0000000000000000000000000000000000000000..91878673c7b0808bf7c813670060957c369778a4
--- /dev/null
+++ b/fpga/camera_hil/experimental_2020_1/csi_patch.py
@@ -0,0 +1,181 @@
+"""Exact, reviewable private CSI changes; never writes the archived inputs."""
+import hashlib
+from pathlib import Path
+
+ROOT = Path('repo/mipi/mipi_csi_rx_4lane/src/mipi-csi-rx')
+HERE = Path(__file__).resolve().parent
+
+
+def digest(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def patch_source(source):
+    changes = []
+    def edit(name, replacements, append=''):
+        path = source / ROOT / name
+        before = path.read_bytes()
+        text = before.decode('utf-8').replace('\r\n', '\n')
+        for old, new in replacements:
+            if text.count(old) != 1:
+                raise ValueError('CSI exact patch context not unique: ' + name + ': ' + old)
+            text = text.replace(old, new)
+        after = (text + append).encode('utf-8')
+        path.write_bytes(after)
+        changes.append(dict(path=(ROOT / name).as_posix(), original_sha256=digest(before),
+                            patched_sha256=digest(after)))
+    edit('csi_4lane_raw10.v', [
+        ('\tinput                reset,', '''\tinput                reset,
+    input                delay_refclock,
+    input                delay_reset,
+    input                io_reset,
+    input                all_ready,
+    output               delay_ready,'''),
+        ('.ref_clock_in(ref_clock_in),', '''.ref_clock_in(ref_clock_in),
+    .delay_refclock(delay_refclock),
+    .delay_reset(delay_reset),
+    .io_reset(io_reset),
+    .all_ready(all_ready),
+    .delay_ready(delay_ready),''')])
+    edit('csi_rx_top.vhd', [
+        ('    byte_clock_out : out std_logic;', '''    delay_refclock : in std_logic; -- private compliant IDELAY reference
+    delay_reset : in std_logic; -- lock-qualified >=52ns reference reset
+    io_reset : in std_logic;
+    all_ready : in std_logic;
+    delay_ready : out std_logic;
+    byte_clock_out : out std_logic;'''),
+        ('      ref_clock => ref_clock_in,', '''      ref_clock => ref_clock_in,
+      delay_refclock => delay_refclock,
+      delay_reset => delay_reset,
+      io_reset => io_reset,
+      all_ready => all_ready,
+      delay_ready => delay_ready,''')])
+    edit('csi_rx_4_lane_link.vhd', [
+        ('    reset : in STD_LOGIC;', '''    delay_refclock : in std_logic;
+    delay_reset : in std_logic;
+    io_reset : in std_logic;
+    all_ready : in std_logic;
+    delay_ready : out std_logic;
+    reset : in STD_LOGIC;'''),
+        ('  signal rdy : std_logic ;', '''  signal rdy : std_logic;
+  signal serdes_reset_det : std_logic;
+  signal ready_byte : std_logic_vector(1 downto 0) := "00";
+  signal ready_count : unsigned(6 downto 0) := (others => '0');
+  signal application_ready : std_logic := '0';
+  signal word_valid_int : std_logic;
+  signal phy_reset : std_logic;
+  attribute ASYNC_REG : string;
+  attribute ASYNC_REG of ready_byte : signal is "TRUE";
+  attribute SHREG_EXTRACT : string;
+  attribute SHREG_EXTRACT of ready_byte : signal is "NO";'''),
+        ('      reset_out => serdes_reset);', '      reset_out => serdes_reset_det);'),
+        ('      valid_out => word_valid);', '      valid_out => word_valid_int);'),
+        ('  gen_idctl : if generate_idelayctrl generate', '''  -- Primitive IO reset releases before IDELAYCTRL, independent of sensor clocks.
+  -- Clock-loss resets are applied to the SERDES only after initial calibration.
+  phy_reset <= io_reset or (serdes_reset_det and application_ready);
+  delay_ready <= rdy;
+  word_valid <= word_valid_int and application_ready;
+  -- ALL used IDELAYCTRLs must calibrate; then wait >=64 local application cycles.
+  -- The original PL0 clock detector remains on the unchanged PL0 clock.
+  process(word_clock_int, reset, delay_reset, all_ready)
+  begin
+    if reset = '1' or delay_reset = '1' or all_ready /= '1' then
+      ready_byte <= "00";
+    elsif rising_edge(word_clock_int) then
+      ready_byte <= ready_byte(0) & '1';
+    end if;
+  end process;
+  process(word_clock_int, reset, all_ready)
+  begin
+    if reset = '1' or all_ready /= '1' then
+      ready_count <= (others => '0');
+      application_ready <= '0';
+    elsif rising_edge(word_clock_int) then
+      if ready_byte(1) = '0' then
+        ready_count <= (others => '0');
+        application_ready <= '0';
+      elsif ready_count < 64 then
+        ready_count <= ready_count + 1;
+      else
+        application_ready <= '1';
+      end if;
+    end if;
+  end process;
+  serdes_reset <= serdes_reset_det or not application_ready;
+  gen_no_idctl : if not generate_idelayctrl generate
+    rdy <= not delay_reset;
+  end generate;
+  gen_idctl : if generate_idelayctrl generate'''),
+        ('        ref_clock => ref_clock,\n        reset => reset,',
+         '        ref_clock => delay_refclock,\n        reset => delay_reset,')]
+        + [('      reset => serdes_reset,\n      dphy_hs => dphy_d' + str(i),
+            '      reset => phy_reset,\n      io_reset => io_reset,\n      application_ready => application_ready,\n      dphy_hs => dphy_d' + str(i)) for i in range(4)])
+    edit('csi_rx_hs_lane_phy.vhd', [
+        ('REFCLK_FREQUENCY => 200.0,  -- IDELAYCTRL', 'REFCLK_FREQUENCY => 301.055970,  -- IDELAYCTRL'),
+        ('  reset : in STD_LOGIC;', '''  io_reset : in STD_LOGIC;
+  application_ready : in STD_LOGIC;
+  reset : in STD_LOGIC;'''),
+        ("        RST => '0'                  -- 1-bit input: Asynchronous Reset", "        RST => io_reset             -- 1-bit input: Asynchronous Reset"),
+        ('          RST => reset_lat ', '          RST => primitive_reset '),
+        ('signal reset_lat : std_logic;', '''signal reset_lat : std_logic;
+signal reset_sync : std_logic_vector(1 downto 0) := "11";
+signal primitive_reset : std_logic;
+attribute ASYNC_REG : string;
+attribute ASYNC_REG of reset_sync : signal is "TRUE";
+attribute SHREG_EXTRACT : string;
+attribute SHREG_EXTRACT of reset_sync : signal is "NO";'''),
+        ('''  process(byte_clock)
+  begin
+  if rising_edge(byte_clock) then
+      reset_lat <= reset;
+  end if;
+  end process;''', '''  process(byte_clock, reset)
+  begin
+    if reset = '1' then
+      reset_sync <= "11";
+    elsif rising_edge(byte_clock) then
+      reset_sync <= reset_sync(0) & '0';
+    end if;
+  end process;
+  reset_lat <= reset_sync(1);
+  primitive_reset <= io_reset or (reset_lat and application_ready);''')])
+    component = source / ROOT.parent.parent / 'component.xml'
+    before = component.read_bytes()
+    text = before.decode('utf-8')
+    ports = ''.join('''    <spirit:port><spirit:name>%s</spirit:name><spirit:wire><spirit:direction>%s</spirit:direction></spirit:wire></spirit:port>\n''' % (n, d) for n, d in
+        [('delay_refclock', 'in'), ('delay_reset', 'in'), ('io_reset', 'in'),
+         ('all_ready', 'in'), ('delay_ready', 'out')])
+    if text.count('</spirit:ports>') != 1:
+        raise ValueError('CSI component port context not unique')
+    after = text.replace('</spirit:ports>', ports + '</spirit:ports>').encode('utf-8')
+    component.write_bytes(after)
+    changes.append(dict(path=component.relative_to(source).as_posix(),
+                        original_sha256=digest(before), patched_sha256=digest(after)))
+    try:
+        from .structural_patch import apply_structural
+    except ImportError:
+        from structural_patch import apply_structural
+    original = {row['path']: row['original_sha256'] for row in changes}
+    for name in ['csi_rx_clock_det.vhd', 'csi_rx_hs_clk_phy.vhd']:
+        original[(ROOT / name).as_posix()] = digest((source / ROOT / name).read_bytes())
+    apply_structural(source)
+    return [dict(path=name, original_sha256=before,
+                 patched_sha256=digest((source/name).read_bytes())) for name,before in original.items()]
+
+
+def verify_patches(camera, build, ledger):
+    """Recompute expected bytes in memory, in a temporary private tree."""
+    import tempfile
+    import shutil
+    with tempfile.TemporaryDirectory(prefix='ah-csi-audit-') as folder:
+        source = Path(folder)
+        shutil.copytree(camera / 'project' / ROOT, source / ROOT)
+        shutil.copy2(camera / 'project' / ROOT.parent.parent / 'component.xml',
+                     source / ROOT.parent.parent / 'component.xml')
+        expected = patch_source(source)
+        if expected != ledger:
+            raise ValueError('CSI patch ledger differs from reviewed exact transformation')
+        for row in expected:
+            if digest((build / 'source' / row['path']).read_bytes()) != row['patched_sha256']:
+                raise ValueError('private CSI source differs from exact patch: ' + row['path'])
+    return {row['path'] for row in expected}
diff --git a/fpga/camera_hil/experimental_2020_1/fix_netlist.tcl b/fpga/camera_hil/experimental_2020_1/fix_netlist.tcl
new file mode 100644
index 0000000000000000000000000000000000000000..dbe549866e82dd22b14fead0a0372d4bc4aca0a4
--- /dev/null
+++ b/fpga/camera_hil/experimental_2020_1/fix_netlist.tcl
@@ -0,0 +1,65 @@
+# Experimental post-opt and post-route hook. No DRC rule or severity is changed.
+# The original routed DCP proves four standalone VDMA URAM288, NONE/NONE,
+# with disconnected cascade inputs. Actual 2020.1 REQP-1869 requires these low.
+set log [open [file join [pwd] netlist_repair.txt] a]
+set urams [get_cells -hier -filter {REF_NAME =~ URAM288*}]
+if {[llength $urams] != 4} {error "Expected exactly four archived VDMA URAMs"}
+set gnd [get_nets -quiet ah_unused_cascade_gnd]
+if {![llength $gnd]} {
+    create_cell -reference GND ah_unused_cascade_gnd_driver
+    create_net ah_unused_cascade_gnd
+    set gnd [get_nets ah_unused_cascade_gnd]
+    connect_net -net $gnd -objects [get_pins ah_unused_cascade_gnd_driver/G]
+}
+set tied 0
+foreach c $urams {
+    if {![regexp {^design_1_i/axi_vdma_[0-3]/U0/.*mem_reg_uram_0$} $c] ||
+        [get_property CASCADE_ORDER_A $c] ne "NONE" ||
+        [get_property CASCADE_ORDER_B $c] ne "NONE"} {error "Unexpected URAM mode/path: $c"}
+    foreach p [get_pins -of_objects $c -filter {DIRECTION == IN && REF_PIN_NAME =~ CAS_IN_*}] {
+        set old [get_nets -quiet -of_objects $p]
+        if {![llength $old]} {
+            connect_net -hier -net $gnd -objects $p
+            if {![llength [get_nets -quiet -of_objects $p]]} {error "Cascade tie failed: $p"}
+            incr tied
+        } elseif {$old ne $gnd} {
+            set drivers [get_pins -quiet -leaf -of_objects [get_nets -segments $old] -filter {DIRECTION == OUT}]
+            set cells [get_cells -quiet -of_objects $drivers]
+            if {[llength $cells] != 1 || [get_property REF_NAME $cells] ne "GND"} {
+                error "Refusing driven non-GND cascade input $p: $old ($drivers)"
+            }
+        }
+    }
+}
+puts $log "URAM_NONE_UNDRIVEN_CASCADE_INPUTS_TIED_LOW=$tied"
+# Remove only nets with a proved primitive output and zero primitive inputs or
+# external ports. Hierarchical aliases are resolved with -segments and -leaf.
+# This disconnects unused outputs; it removes no functional load or cell.
+set removed 0
+foreach n [get_nets -hier -filter {ROUTE_STATUS == NOLOADS}] {
+    # Limit to the proved unused FIFO status outputs named in actual RTSTAT-10.
+    # Do not edit encrypted debug internals, macro sub-pins, buses, or resets.
+    if {![regexp {/(overflow|underflow|aempty_fwft_i|ram_empty_i)$} $n]} {continue}
+    if {![llength [get_nets -quiet $n]]} {continue}
+    set segments [get_nets -quiet -segments $n]
+    set protected 0
+    foreach flag [get_property DONT_TOUCH $segments] {
+        if {$flag eq "1" || [string equal -nocase $flag true]} {set protected 1}
+    }
+    if {$protected} {puts $log "RETAINED_PROTECTED_NOLOAD_NET=$n"; continue}
+    set leaf [get_pins -quiet -leaf -of_objects $segments]
+    set inputs [filter $leaf {DIRECTION == IN}]
+    set outputs [filter $leaf {DIRECTION == OUT}]
+    set ports [get_ports -quiet -of_objects $segments]
+    if {[llength $inputs] == 0 && [llength $outputs] == 1 && [llength $ports] == 0} {
+        remove_net $segments
+        if {[llength [get_nets -quiet $n]]} {
+            puts $log "RETAINED_NOLOAD_NET_AFTER_NATIVE_REMOVE=$n DRIVER=$outputs"
+        } else {
+            puts $log "REMOVED_UNUSED_NET=$n DRIVER=$outputs INPUTS=0 PORTS=0"
+            incr removed
+        }
+    } else {puts $log "RETAINED_NOLOAD_NET=$n OUTPUTS=$outputs INPUTS=$inputs PORTS=$ports"}
+}
+puts $log "UNUSED_OUTPUT_NETS_REMOVED=$removed"
+close $log
diff --git a/fpga/camera_hil/experimental_2020_1/inspect_dcp.tcl b/fpga/camera_hil/experimental_2020_1/inspect_dcp.tcl
new file mode 100644
index 0000000000000000000000000000000000000000..b4522b78c19c590a3c9b09ce395c932feeefb52b
--- /dev/null
+++ b/fpga/camera_hil/experimental_2020_1/inspect_dcp.tcl
@@ -0,0 +1,34 @@
+# Read-only inspection. Never writes or reuses the old implementation outputs.
+if {[llength $argv] < 2 || [llength $argv] > 3} {error "usage: inspect_dcp.tcl routed.dcp NEW_RESULT ?netlist_hook?"}
+lassign $argv dcp out hook
+if {[file exists $out]} {error "result already exists"}
+file mkdir $out
+open_checkpoint $dcp
+set f [open [file join $out primitives.txt] w]
+foreach c [get_cells -hier -filter {REF_NAME =~ URAM288*}] {
+    puts $f "URAM $c A=[get_property CASCADE_ORDER_A $c] B=[get_property CASCADE_ORDER_B $c]"
+    foreach p [get_pins -of_objects $c -filter {DIRECTION == IN && REF_PIN_NAME =~ CAS_IN_*}] {
+        set n [get_nets -quiet -of_objects $p]
+        set drivers [get_pins -quiet -of_objects $n -filter {DIRECTION == OUT}]
+        puts $f "$p NET=$n DRIVER=$drivers"
+    }
+}
+foreach n [get_nets -hier -filter {ROUTE_STATUS == NOLOADS}] {
+    puts $f "NOLOAD $n PINS=[get_pins -of_objects $n] PORTS=[get_ports -quiet -of_objects $n]"
+}
+close $f
+check_timing -verbose -file [file join $out coverage.rpt]
+report_clock_networks -file [file join $out clock_networks.rpt]
+report_drc -checks RTSTAT-10 -file [file join $out noload_drc.rpt]
+set df [open [file join $out noload_objects.txt] w]
+foreach v [get_drc_violations] {
+    report_property -all $v -file [file join $out violation_properties.txt] -append
+    puts $df "$v NETS=[get_nets -quiet -of_objects $v]"
+}
+close $df
+if {$hook ne ""} {
+    cd $out
+    source $hook
+    report_drc -file [file join $out repaired_drc.rpt]
+}
+exit
