index 0000000000000000000000000000000000000000..4912977f5a1ce94beeef1295458784f6671ec165
--- /dev/null
+++ b/fpga/camera_hil/ps/unified.py
@@ -0,0 +1,223 @@
+#!/usr/bin/env python3
+"""RAM-only camera/HIL loader and foreground HIL service (Python 3.7 stdlib).
+
+No detached 'start' action: only a successful load in this same locked process
+permits AHIL AXI access. A saved boot_id/loaded.json cannot identify current PL.
+The camera may start AFTER the HIL service reports ready. Reload/rollback always
+requires it to be stopped and unloaded by an authorized operator beforehand.
+"""
+import argparse
+import hashlib
+import json
+import mmap
+import os
+from pathlib import Path
+import signal
+import socket
+import struct
+import subprocess
+import sys
+
+ROOT = Path(__file__).resolve().parent
+MANAGER = Path('/sys/class/fpga_manager/fpga0')
+FW_PATH = Path('/sys/module/firmware_class/parameters/path')
+CAMERA_SHA = 'e25e9bc7fd4c2008c7a198a91bc4937716b333259d08da7ed777d8ffe9b3384b'
+
+
+def require(condition, message):
+    if not condition:
+        raise RuntimeError(message)
+
+
+def digest(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def verified_manifest():
+    manifest = json.loads((ROOT / 'manifest.json').read_text())
+    require(manifest['profile'] == 'camera-hil/1' and manifest['base'] == 0xa1000000
+            and manifest['clock_hz'] == 200703980 and manifest['data_width'] == 128,
+            'wrong unified profile')
+    files = manifest['files_sha256']
+    require(set(files) == {'unified.py', 'hil_server.py', 'camera-hil.bin', 'camera-original.bin'},
+            'incomplete runtime package')
+    for name, expected in files.items():
+        require(digest(ROOT / name) == expected, 'package hash mismatch: ' + name)
+    require(files['camera-original.bin'] == CAMERA_SHA, 'unreviewed camera fallback')
+    return manifest
+
+
+def reject_active_users(modules, devices, processes):
+    """Pure guard shared by preflight and safety regression tests."""
+    require('ah_camera0' not in modules and 'mipi_cam' not in modules,
+            'camera driver loaded: stop capture/preview, confirm DMA halt, then unload manually')
+    for name, bound in devices:
+        try:
+            address = int(name.split('.')[0], 16)
+        except ValueError:
+            continue
+        require(not (0x80000000 <= address < 0xc0000000 and bound),
+                'bound PL driver: ' + name)
+    require(not processes, 'active PL/device mappings: ' + ', '.join(processes))
+
+
+def reject_dma_fault(log):
+    require('DMA failed to halt' not in log and 'refusing to free unhalted DMA' not in log,
+            'camera DMA halt failure recorded; preserve state and request manual recovery')
+
+
+def live_users():
+    users = []
+    # No PL MMIO is read to check for DMA. Unloaded reviewed camera module and
+    # absence of mappings are prerequisites; unknown/broken DMA needs manual recovery.
+    for proc in Path('/proc').iterdir():
+        if not proc.name.isdigit() or int(proc.name) == os.getpid():
+            continue
+        try:
+            for fd in (proc / 'fd').iterdir():
+                try:
+                    target = os.readlink(str(fd))
+                except FileNotFoundError:
+                    continue
+                if target in ['/dev/mem', '/dev/ah_camera0', '/dev/mipi_cam'] or target.startswith('/dev/uio'):
+                    users.append(proc.name + ':' + target)
+            # mmap can outlive its fd. Check maps as well, including /dev/mem.
+            for line in (proc / 'maps').read_text().splitlines():
+                if any(path in line for path in ['/dev/mem', '/dev/ah_camera0', '/dev/mipi_cam', '/dev/uio']):
+                    users.append(proc.name + ':mmap')
+        except (FileNotFoundError, ProcessLookupError):
+            continue
+    return sorted(set(users))
+
+
+def preflight():
+    require(os.geteuid() == 0, 'board root required')
+    require(os.uname().machine == 'aarch64' and os.uname().release == '5.4.0-xilinx-v2020.2',
+            'wrong board Linux profile')
+    require(ROOT.parent == Path('/run') and ROOT.name.startswith('amazinghand-camera-hil-'),
+            'extract directly below /run/amazinghand-camera-hil-*')
+    require(any(line.split()[1:3] == ['/run', 'tmpfs']
+                for line in Path('/proc/mounts').read_text().splitlines()), '/run must be RAM tmpfs')
+    require(not Path('/dev/ah_camera0').exists() and not Path('/dev/mipi_cam').exists(),
+            'camera device still present')
+    modules = {line.split()[0] for line in Path('/proc/modules').read_text().splitlines()}
+    devices = [(dev.name, (dev / 'driver').exists())
+               for dev in Path('/sys/bus/platform/devices').iterdir()]
+    reject_active_users(modules, devices, live_users())
+    reject_dma_fault(subprocess.check_output(['dmesg'], universal_newlines=True))
+    for line in Path('/proc/iomem').read_text().splitlines():
+        low, high = (int(v, 16) for v in line.strip().split(' : ')[0].split('-'))
+        require(high < 0xa1000000 or low > 0xa1000fff, 'AHIL range owned: ' + line.strip())
+    clocks = {}
+    for line in Path('/sys/kernel/debug/clk/clk_summary').read_text().splitlines():
+        cols = line.split()
+        if cols and cols[0] in ['pl0_ref', 'pl1_ref']:
+            require(int(cols[1]) > 0, 'disabled PL clock')
+            clocks[cols[0]] = int(cols[4])
+    require(abs(clocks.get('pl0_ref', 0) - 200703980) <= 1000, 'PL0 clock mismatch')
+    require(abs(2 * clocks.get('pl1_ref', 0) - clocks['pl0_ref']) <= 1000,
+            'PL1 clock must match preserved 2:1 reference profile')
+    registers = {}
+    fd = os.open('/dev/mem', os.O_RDONLY | os.O_SYNC)
+    try:
+        # Read only known PS registers: HPM0 128-bit, HP1 128-bit, reset released.
+        # Never probe camera/VDMA/AHIL addresses before successful programming.
+        for address, mask, expected in [(0xfd615000, 0x300, 0x200),
+                                        (0xfd390000, 3, 0), (0xfd390014, 3, 0),
+                                        (0xfd1a0100, 0x1f80, 0)]:
+            with mmap.mmap(fd, 4096, flags=mmap.MAP_SHARED, prot=mmap.PROT_READ,
+                           offset=address & ~4095) as mem:
+                result = struct.unpack_from('<I', mem, address & 4095)[0]
+                require(result & mask == expected, 'PS profile mismatch: ' + hex(address))
+                registers[hex(address)] = hex(result)
+    finally:
+        os.close(fd)
+    require(MANAGER.is_dir() and FW_PATH.exists(), 'FPGA Manager/path override missing')
+    return dict(clocks=clocks, ps_registers=registers, pl_mmio_read=False,
+                camera_unloaded=True, active_pl_users=False)
+
+
+def program(path):
+    old_path = FW_PATH.read_text().strip()
+    old_flags = (MANAGER / 'flags').read_text().strip()
+    try:
+        FW_PATH.write_text(str(path.parent))
+        (MANAGER / 'flags').write_text('0')
+        (MANAGER / 'firmware').write_text(path.name)
+        require((MANAGER / 'state').read_text().strip() == 'operating', 'FPGA programming failed')
+    finally:
+        FW_PATH.write_bytes(old_path.encode() + b'\0')
+        (MANAGER / 'flags').write_text(old_flags)
+        require(FW_PATH.read_text().strip() == old_path, 'firmware search path restore failed')
+
+
+def serve(device, bind, port):
+    from hil_server import serve_connection
+    with socket.socket() as listener:
+        listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+        listener.bind((bind, port))
+        listener.listen(1)
+        print('UNIFIED_HIL_READY %s:%d; camera driver/preview may now be started manually' %
+              (bind, port), flush=True)
+        while True:
+            conn, peer = listener.accept()
+            try:
+                with conn:
+                    serve_connection(conn, device)
+            except (ValueError, OSError, RuntimeError) as error:
+                print('HIL session stopped: ' + str(error), flush=True)
+            finally:
+                device.stop()
+
+
+def approved_action(action, approved, manifest, bind, port):
+    require(action == 'preflight' or approved,
+            'PL reload requires explicit current Citlali6 approval; --confirm-human-approved-reload')
+    facts = preflight()
+    print(json.dumps(facts, sort_keys=True), flush=True)
+    if action == 'preflight':
+        return
+    if action == 'restore-camera':
+        program(ROOT / 'camera-original.bin')
+        print('ORIGINAL_CAMERA_PL_RESTORED; driver/preview remain stopped', flush=True)
+        return
+    program(ROOT / 'camera-hil.bin')
+    # Keep loading and MMIO access in one process/session. No state marker can
+    # authorize a later 'start' after another full PL load.
+    from hil_server import PlDevice
+    device = PlDevice(manifest['base'])
+    try:
+        device.stop()
+        print(json.dumps(dict(initial_pl=device.snapshot())), flush=True)
+        serve(device, bind, port)
+    finally:
+        device.close()
+
+
+def main():
+    import fcntl  # Linux-only; pure safety checks remain testable on the PC.
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('action', choices=['preflight', 'run', 'restore-camera'])
+    parser.add_argument('--confirm-human-approved-reload', action='store_true')
+    parser.add_argument('--bind', default='127.0.0.1')
+    parser.add_argument('--port', default=8765, type=int)
+    args = parser.parse_args()
+    require(os.geteuid() == 0 and ROOT.parent == Path('/run'), 'run as board root from /run only')
+    # One shared lock across all NEW unified packages, held for the full HIL
+    # session. Other/legacy loaders do not obey it: operator exclusivity remains mandatory.
+    with Path('/run/amazinghand-pl.lock').open('a') as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        manifest = verified_manifest()
+        def shutdown(signum, frame):
+            raise KeyboardInterrupt
+        signal.signal(signal.SIGTERM, shutdown)
+        approved_action(args.action, args.confirm_human_approved_reload, manifest, args.bind, args.port)
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except KeyboardInterrupt:
+        pass
+    except (RuntimeError, OSError, ValueError, KeyError) as error:
+        sys.exit('UNIFIED_DEPLOY_REFUSED: ' + str(error))
diff --git a/fpga/camera_hil/rtl/grasp_fsm.sv b/fpga/camera_hil/rtl/grasp_fsm.sv
new file mode 100644
index 0000000000000000000000000000000000000000..9de6db4c2bd7032f50e131b3c43eee0c0361de09
--- /dev/null
+++ b/fpga/camera_hil/rtl/grasp_fsm.sv
@@ -0,0 +1,216 @@
+// ============================================================================
+// grasp_fsm.sv — 力控抓握状态机（作品 FPGA 核心，评分 25 分项）
+//
+// 行为权威：host/app/control/backend_sim.py 内软件状态机（golden model #2），
+// 迁移条件逐条对照：
+//   IDLE --CMD01(enable)--> PREGRASP[力矩on, 目标=预张快照, 0.3s]
+//     --> CLOSING[目标=TARGET寄存器, 速度事件一次, 监视任一在线通道
+//                 load >= level*64（对照 TORQUE_LEVEL_STEP=64）]
+//       --> HOLD[锁存回读位置为新目标; 到位/触力→grasped, 3s 超时→timeout]
+//         --CMD02--> RELEASING[目标=预张快照, 0.5s] --> IDLE
+//   HOLD 中任一舵机掉线 → PROTECT[力矩off]；CMD04 arg=1 手动复位 → IDLE
+//   CMD03：快照当前 TARGET_i 为预张角（host 先写角再发 0x03）
+//   estop 电平或 PROTECT：力矩事件 off
+// ============================================================================
+`default_nettype none
+
+module grasp_fsm #(
+    parameter int CLK_HZ      = 100_000_000,
+    parameter int TICK_CYC    = 1_000_000,  // 10ms 节拍周期数（TB 缩小加速仿真）
+    parameter int PREGRASP_T  = 30,         // ×10ms = 0.3s（对照 PREGRASP_S）
+    parameter int RELEASING_T = 50,         // 0.5s
+    parameter int CLOSING_T   = 300         // 3.0s
+) (
+    input  wire        clk,
+    input  wire        rst_n,
+    // 寄存器命令（axi_lite_regs 写脉冲）
+    input  wire        cmd_valid,
+    input  wire [7:0]  cmd_id,        // 0x01 抓取 0x02 释放 0x03 预张快照 0x04 力矩(arg=1/0)
+    input  wire [7:0]  cmd_arg,
+    input  wire        estop,         // CTRL.estop 电平
+    input  wire        enable,        // CTRL.enable
+    // 抓取参数（寄存器面）
+    input  wire [95:0] target_pos,    // 8×12bit raw（抓取目标）
+    input  wire [31:0] torque_lim,    // 8×4bit 等级（阈值 = level<<6）
+    input  wire [7:0]  speed_raw,
+    // 回读（servo_bus_ctrl）
+    input  wire [15:0] meas_load   [8],
+    input  wire [15:0] meas_pos    [8],
+    input  wire [7:0]  online_bitmap,
+    // 控制输出（servo_bus_ctrl）
+    output logic [95:0] ctrl_target,
+    output logic        torque_on,
+    output logic        speed_event,
+    output logic        evt_torque_valid,
+    output logic [7:0]  evt_torque_arg,
+    // 状态寄存器面
+    output logic [2:0]  fsm_state,
+    output logic        fsm_busy,
+    output logic        grasped,
+    output logic        timeout_flag,
+    output logic        fault
+);
+    localparam int unsigned TL_STEP_SH  = 6;   // 阈值 = level << 6
+
+    typedef enum logic [2:0] {
+        S_IDLE = 3'd0, S_PREGRASP = 3'd1, S_CLOSING = 3'd2,
+        S_HOLD = 3'd3, S_RELEASING = 3'd4, S_PROTECT = 3'd5
+    } state_e;
+
+    state_e st, st_next;
+    logic [15:0] t_10ms;      // 态内 10ms 计数
+    logic [95:0] pregrasp_snap;
+    logic [95:0] hold_snap;
+    logic        hold_valid;
+    logic        load_hit_q;  // 迁移瞬间采样（区分 grasped / timeout）
+    logic        speed_fired;
+
+    // ---- 10ms tick（TICK_CYC 参数化：板端=1_000_000；TB 缩小加速仿真）----
+    localparam int MS_CYC = TICK_CYC / 10;      // 1ms 周期数
+    logic [19:0] ms_cnt;
+    wire tick10 = (ms_cnt == MS_CYC - 1);
+    always_ff @(posedge clk or negedge rst_n) begin
+        if (!rst_n) ms_cnt <= '0;
+        else ms_cnt <= tick10 ? '0 : ms_cnt + 1'b1;
+    end
+    logic [5:0] ms10_cnt;
+    always_ff @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            ms10_cnt <= '0;
+        end else if (tick10) begin
+            ms10_cnt <= (ms10_cnt == 9) ? '0 : ms10_cnt + 1'b1;
+        end
+    end
+    wire tick_10ms = tick10 && (ms10_cnt == 0);  // 10ms 精确节拍
+
+    // ---- 力控判定：任一在线通道负载达到阈值 ----
+    logic load_hit_c;
+    always_comb begin
+        load_hit_c = 1'b0;
+        for (int i = 0; i < 8; i++) begin
+            logic [15:0] thr;
+            thr = {12'd0, torque_lim[i*4 +: 4]} << TL_STEP_SH;
+            if (online_bitmap[i] && torque_lim[i*4 +: 4] != 4'd0 &&
+                meas_load[i] >= thr) begin
+                load_hit_c = 1'b1;
+            end
+        end
+    end
+
+    // ---- 组合迁移 ----
+    always_comb begin
+        st_next = st;  // 默认保持
+        unique case (st)
+            S_IDLE:      if (cmd_valid && cmd_id == 8'h01 && enable && !estop)
+                             st_next = S_PREGRASP;
+                         else if (cmd_valid && cmd_id == 8'h05 && enable && !estop)
+                             st_next = S_HOLD;
+            S_PREGRASP:  if (cmd_valid && cmd_id == 8'h05) st_next = S_HOLD;
+                         else if (tick_10ms && t_10ms >= PREGRASP_T[15:0]) st_next = S_CLOSING;
+            S_CLOSING:   if ((cmd_valid && cmd_id == 8'h05) || load_hit_c ||
+                             (tick_10ms && t_10ms >= CLOSING_T[15:0])) st_next = S_HOLD;
+            S_HOLD: begin
+                if (online_bitmap != 8'hFF)              st_next = S_PROTECT;
+                else if (cmd_valid && cmd_id == 8'h02)   st_next = S_RELEASING;
+            end
+            S_RELEASING: if (tick_10ms && t_10ms >= RELEASING_T[15:0]) st_next = S_IDLE;
+            S_PROTECT:   if (cmd_valid && cmd_id == 8'h04 && cmd_arg == 8'd1 &&
+                            enable && !estop && online_bitmap == 8'hFF)
+                             st_next = S_IDLE;
+            default: st_next = S_IDLE;
+        endcase
+        // Explicit release is accepted in every non-protected state.
+        if (cmd_valid && cmd_id == 8'h02 && st != S_PROTECT)
+            st_next = S_RELEASING;
+        if (estop || ((st != S_IDLE && st != S_PROTECT) &&
+                      (!enable || online_bitmap != 8'hFF))) st_next = S_PROTECT;
+    end
+
+    // ---- 状态寄存 + 副作用 ----
+    always_ff @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            st <= S_IDLE;
+            t_10ms <= '0;
+            pregrasp_snap <= '0;
+            hold_snap <= '0; hold_valid <= 1'b0;
+            torque_on <= 1'b0;
+            timeout_flag <= 1'b0;
+            load_hit_q <= 1'b0;
+            evt_torque_valid <= 1'b0; evt_torque_arg <= '0;
+        end else begin
+            evt_torque_valid <= 1'b0;
+            if (st != st_next) t_10ms <= '0;
+            else if (tick_10ms) t_10ms <= t_10ms + 1'b1;
+            st <= st_next;
+
+            // 迁移瞬间采样（区分 grasped/timeout）
+            if (st != S_HOLD && st_next == S_HOLD) begin
+                load_hit_q <= load_hit_c;
+                timeout_flag <= !load_hit_c && !(cmd_valid && cmd_id == 8'h05);
+                // 锁存回读位置为 HOLD 目标（对照 Python _closing_hold_raw）
+                hold_snap <= {meas_pos[7][11:0], meas_pos[6][11:0],
+                              meas_pos[5][11:0], meas_pos[4][11:0],
+                              meas_pos[3][11:0], meas_pos[2][11:0],
+                              meas_pos[1][11:0], meas_pos[0][11:0]};
+                hold_valid <= 1'b1;
+            end
+            if (st_next == S_PREGRASP) timeout_flag <= 1'b0;
+            if (st_next == S_IDLE) begin
+                hold_valid <= 1'b0;
+                timeout_flag <= 1'b0;
+            end
+
+            // 副作用：力矩事件
+            if ((st_next == S_PREGRASP || st_next == S_HOLD || st_next == S_RELEASING) &&
+                !torque_on && !estop && enable) begin
+                torque_on <= 1'b1;
+                evt_torque_valid <= 1'b1;
+                evt_torque_arg <= 8'd1;
+            end
+            if (st_next == S_PROTECT && torque_on) begin
+                torque_on <= 1'b0;
+                evt_torque_valid <= 1'b1;
+                evt_torque_arg <= 8'd0;
+            end
+            // CMD04 手动力矩（IDLE 下）
+            if (cmd_valid && cmd_id == 8'h04 && st == S_IDLE && !estop && enable) begin
+                if (cmd_arg == 8'd1 && !torque_on) begin
+                    torque_on <= 1'b1;
+                    evt_torque_valid <= 1'b1; evt_torque_arg <= 8'd1;
+                end else if (cmd_arg == 8'd0 && torque_on) begin
+                    torque_on <= 1'b0;
+                    evt_torque_valid <= 1'b1; evt_torque_arg <= 8'd0;
+                end
+            end
+            // CMD03 预张快照（任意态允许，抓取前使用）
+            if (cmd_valid && cmd_id == 8'h03) pregrasp_snap <= target_pos;
+        end
+    end
+
+    // 速度事件：进入 CLOSING 时触发一次
+    always_ff @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            speed_event <= 1'b0; speed_fired <= 1'b0;
+        end else begin
+            speed_event <= 1'b0;
+            if (st_next == S_PREGRASP) speed_fired <= 1'b0;
+            if (st == S_PREGRASP && st_next == S_CLOSING && !speed_fired) begin
+                speed_event <= 1'b1;
+                speed_fired <= 1'b1;
+            end
+        end
+    end
+
+    // ---- 输出多路与状态字 ----
+    always_comb begin
+        unique case (st)
+            S_PREGRASP, S_RELEASING: ctrl_target = pregrasp_snap;
+            S_HOLD:                  ctrl_target = hold_snap;
+            default:                 ctrl_target = target_pos;
+        endcase
+    end
+    assign fsm_state = st;
+    assign fsm_busy  = (st == S_PREGRASP) || (st == S_CLOSING) || (st == S_RELEASING);
+    assign grasped   = (st == S_HOLD) && hold_valid && !timeout_flag;
+    assign fault     = (st == S_PROTECT);
+endmodule
diff --git a/fpga/camera_hil/rtl/hand_hil_axi.sv b/fpga/camera_hil/rtl/hand_hil_axi.sv
new file mode 100644
index 0000000000000000000000000000000000000000..25a4dd8d374ceb65e6562d67cfffadf020dd09fd
--- /dev/null
+++ b/fpga/camera_hil/rtl/hand_hil_axi.sv
@@ -0,0 +1,158 @@
+// HIL-only AXI4-Lite bank. No physical servo pins. Offsets are relative.
+// Independent AW/W capture; one outstanding write/read; WSTRB respected.
+`default_nettype none
+module hand_hil_axi #(
+    parameter integer CLK_HZ=100000000,
+    parameter integer WATCHDOG_CYC=50000000,
+    parameter integer FSM_TICK_CYC=1000000
+)(
+    (* X_INTERFACE_PARAMETER = "XIL_INTERFACENAME clk, ASSOCIATED_BUSIF s_axi, ASSOCIATED_RESET rst_n" *)
+    input wire clk,
+    (* X_INTERFACE_PARAMETER = "XIL_INTERFACENAME rst_n, POLARITY ACTIVE_LOW" *)
+    input wire rst_n,
+    input wire [11:0] s_axi_awaddr, input wire s_axi_awvalid, output wire s_axi_awready,
+    input wire [31:0] s_axi_wdata, input wire [3:0] s_axi_wstrb,
+    input wire s_axi_wvalid, output wire s_axi_wready,
+    output wire [1:0] s_axi_bresp, output logic s_axi_bvalid, input wire s_axi_bready,
+    input wire [11:0] s_axi_araddr, input wire s_axi_arvalid, output wire s_axi_arready,
+    output logic [31:0] s_axi_rdata, output wire [1:0] s_axi_rresp,
+    output logic s_axi_rvalid, input wire s_axi_rready
+);
+    localparam MAGIC=32'h4148494c;
+    logic aw_full,w_full;
+    logic [11:0] aw_q;
+    logic [31:0] w_q;
+    logic [3:0] strb_q;
+    logic [31:0] shadow[0:63];
+    logic [31:0] accepted_seq,feedback_seq,pl_tick,command_count,feedback_count;
+    logic [31:0] heartbeat,last_heartbeat,age;
+    logic [31:0] fault_bits;
+    logic [95:0] target,ctrl_target;
+    logic [15:0] pos[8],load[8];
+    logic [7:0] online;
+    logic cmd_valid,reset_fsm,torque_on;
+    logic [7:0] cmd_id,cmd_arg;
+    logic [2:0] state;
+    logic busy,grasped,timed_out,fsm_fault;
+    logic [2:0] pending;
+    logic [2:0] seed_pending;
+    logic [31:0] snap[0:31];
+    wire safe = fault_bits != 0;
+    wire torque_enabled = torque_on && !safe;
+    wire fsm_rst_n = rst_n && !reset_fsm;
+    assign s_axi_awready=!aw_full&&!s_axi_bvalid;
+    assign s_axi_wready=!w_full&&!s_axi_bvalid;
+    assign s_axi_arready=!s_axi_rvalid;
+    assign s_axi_bresp=0;
+    assign s_axi_rresp=0;
+    grasp_fsm #(.CLK_HZ(CLK_HZ),.TICK_CYC(FSM_TICK_CYC)) u_fsm(
+      .clk(clk),.rst_n(fsm_rst_n),.cmd_valid(cmd_valid),.cmd_id(cmd_id),.cmd_arg(cmd_arg),
+      .estop(safe),.enable(!safe),.target_pos(target),.torque_lim(32'h66666666),
+      .speed_raw(8'd3),.meas_load(load),.meas_pos(pos),.online_bitmap(online),
+      .ctrl_target(ctrl_target),.torque_on(torque_on),.speed_event(),
+      .evt_torque_valid(),.evt_torque_arg(),.fsm_state(state),.fsm_busy(busy),
+      .grasped(grasped),.timeout_flag(timed_out),.fault(fsm_fault));
+
+    always_ff @(posedge clk or negedge rst_n) begin
+      if(!rst_n) begin
+        aw_full<=0;w_full<=0;s_axi_bvalid<=0;aw_q<=0;w_q<=0;strb_q<=0;
+        s_axi_rvalid<=0;s_axi_rdata<=0;
+        accepted_seq<=0;feedback_seq<=0;pl_tick<=0;command_count<=0;feedback_count<=0;
+        heartbeat<=0;last_heartbeat<=0;age<=0;fault_bits<=2;
+        target<=0;online<=0;cmd_valid<=0;cmd_id<=0;cmd_arg<=0;pending<=0;seed_pending<=0;reset_fsm<=0;
+        for(integer i=0;i<64;i=i+1) shadow[i]<=0;
+        for(integer i=0;i<32;i=i+1) snap[i]<=0;
+        for(integer i=0;i<8;i=i+1) begin pos[i]<=0;load[i]<=0;end
+      end else begin
+        pl_tick<=pl_tick+1;
+        cmd_valid<=0;reset_fsm<=0;
+        if(age<WATCHDOG_CYC) age<=age+1;
+        else begin fault_bits<=fault_bits|1;pending<=0;end
+        // Offline feedback is a latched fault in all enabled states.
+        if(!safe && online!=8'hff) begin fault_bits<=fault_bits|4;pending<=0;end
+        if(pending!=0 && !safe) begin
+          pending<=pending-1;
+          if(pending==3) begin cmd_valid<=1;cmd_id<=3;cmd_arg<=0;end
+          if(pending==1) begin cmd_valid<=1;cmd_id<=4;cmd_arg<=1;end
+        end
+        // Reset seeds a fresh pregrasp snapshot without torque. This makes a
+        // first grasp/release safe even if the operator has not issued open.
+        if(seed_pending!=0 && !safe) begin
+          seed_pending<=seed_pending-1;
+          if(seed_pending==1) begin cmd_valid<=1;cmd_id<=3;cmd_arg<=0;end
+        end
+        if(s_axi_awvalid&&s_axi_awready) begin aw_full<=1;aw_q<=s_axi_awaddr;end
+        if(s_axi_wvalid&&s_axi_wready) begin w_full<=1;w_q<=s_axi_wdata;strb_q<=s_axi_wstrb;end
+        if(s_axi_bvalid&&s_axi_bready) s_axi_bvalid<=0;
+        if(aw_full&&w_full&&!s_axi_bvalid) begin
+          aw_full<=0;w_full<=0;s_axi_bvalid<=1;
+          if(aw_q[1:0]==0 && aw_q<256) begin
+            for(integer b=0;b<4;b=b+1)
+              if(strb_q[b]) shadow[aw_q[7:2]][8*b+:8]<=w_q[8*b+:8];
+          end
+          // 0x18 COMMIT=1: atomic copy of the entire request shadow.
+          if(aw_q==12'h018 && strb_q==15 && w_q==1) begin
+            if(shadow[4]<=accepted_seq || shadow[5]==last_heartbeat) begin
+              fault_bits<=fault_bits|8;pending<=0;
+            end else begin
+              accepted_seq<=shadow[4];feedback_seq<=shadow[4];
+              heartbeat<=shadow[5];last_heartbeat<=shadow[5];age<=0;
+              feedback_count<=feedback_count+1;
+              online<=shadow[3][7:0];
+              for(integer i=0;i<8;i=i+1) begin
+                pos[i]<={4'd0,shadow[16+i][11:0]};load[i]<=shadow[24+i][15:0];
+              end
+              // command IDs: tick0 reset1 open2 grasp3 hold4 release5 stop6.
+              if(shadow[2]==1 && shadow[3][7:0]==255) begin
+                fault_bits<=0;reset_fsm<=1;pending<=0;seed_pending<=3;
+                for(integer i=0;i<8;i=i+1) target[i*12+:12]<=shadow[16+i][11:0];
+              end else if(shadow[2]==6) begin fault_bits<=fault_bits|2;pending<=0;end
+              else if(shadow[3][7:0]!=255) begin fault_bits<=fault_bits|4;pending<=0;end
+              else if(shadow[2]>6) begin fault_bits<=fault_bits|16;pending<=0;end
+              else if(!safe) begin
+                if(shadow[2]!=0) command_count<=command_count+1;
+                case(shadow[2])
+                  2: if(state==0) begin
+                    for(integer i=0;i<8;i=i+1) target[i*12+:12]<=shadow[8+i][11:0];
+                    pending<=3;
+                  end
+                  3: if(state==0) begin
+                    for(integer i=0;i<8;i=i+1) target[i*12+:12]<=shadow[8+i][11:0];
+                    cmd_valid<=1;cmd_id<=1;cmd_arg<=0;
+                  end
+                  4: begin
+                    cmd_valid<=1;cmd_id<=5;cmd_arg<=0;
+                    if(state==0) for(integer i=0;i<8;i=i+1) target[i*12+:12]<=shadow[16+i][11:0];
+                  end
+                  5: begin cmd_valid<=1;cmd_id<=2;cmd_arg<=0;end
+                  default: ;
+                endcase
+              end
+            end
+          end
+          // 0x1c SNAPSHOT=1: coherent telemetry for PS reads at 0x100.
+          if(aw_q==12'h01c && strb_q==15 && w_q==1) begin
+            snap[0]<=safe?5:{29'd0,state};snap[1]<={31'd0,torque_enabled};
+            snap[2]<=fault_bits;snap[3]<=pl_tick;snap[4]<=accepted_seq;snap[5]<=feedback_seq;
+            snap[6]<=command_count;snap[7]<=feedback_count;
+            for(integer i=0;i<8;i=i+1) begin
+              snap[8+i]<=torque_enabled?{20'd0,ctrl_target[i*12+:12]}:{16'd0,pos[i]};
+              snap[16+i]<={16'd0,pos[i]};snap[24+i]<={16'd0,load[i]};
+            end
+          end
+          if(aw_q==12'h0f0 && strb_q[0] && w_q[0]) begin
+            fault_bits<=fault_bits|2;pending<=0;
+          end
+        end
+        if(s_axi_rvalid&&s_axi_rready) s_axi_rvalid<=0;
+        if(s_axi_arvalid&&s_axi_arready) begin
+          s_axi_rvalid<=1;
+          if(s_axi_araddr==0) s_axi_rdata<=MAGIC;
+          else if(s_axi_araddr==4) s_axi_rdata<=1;
+          else if(s_axi_araddr>=256 && s_axi_araddr<384) s_axi_rdata<=snap[(s_axi_araddr-256)>>2];
+          else s_axi_rdata<=0;
+        end
+      end
+    end
+endmodule
+`default_nettype wire
diff --git a/fpga/camera_hil/rtl/hand_hil_shell.v b/fpga/camera_hil/rtl/hand_hil_shell.v
