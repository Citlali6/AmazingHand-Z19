@@ -0,0 +1,190 @@
+"""RTL 环后端 —— AXI4-Lite 寄存器访问（/dev/mem mmap），作品核心链路。
+
+寄存器映射 = ``docs/design/interface.md`` v0.2（唯一契约）::
+
+    控制区: CTRL 0x00 | CMD 0x04 | TARGET_i 0x10+i*4 | TORQUE_LIM 0x30 | TIMING 0x34
+    状态区: STATUS 0x80 | FSM_STATE 0x84 | MEAS_i 0x90+i*4 | LOAD 0xB0+i*2(半字×8)
+            TEMP 0xD0 | ERR_BITMAP 0xE0 | TIMESTAMP 0xF0
+
+- 仅 Linux 板端可用（/dev/mem）；Windows 上 open() 会报错（PC 冒烟用 sim 后端）；
+- 角度 0.1° 定点编码细则属 interface.md 待定项 1，当前按
+  ``val = round(deg*10) & 0xFFF``（相对中位、无符号偏置待标定）占位——
+  定稿时本文件与 PL 侧同一批修订；
+- 控制环时序完全由 PL 内 grasp_fsm/servo_bus_ctrl 硬件保证，
+  本模块只做"写下发、读回读"，不参与实时调度（这正是对比实验的变量控制）。
+"""
+
+from __future__ import annotations
+
+import math
+from typing import Iterable
+
+from app.control.servo_base import (
+    N_JOINTS,
+    FsmState,
+    FsmSnapshot,
+    GraspPlan,
+    ServoBackend,
+    ServoFeedback,
+)
+
+# ---- 寄存器偏移（interface.md v0.2） ----
+REG_CTRL = 0x00  # [0] enable [1] mode [2] estop
+REG_CMD = 0x04  # [7:0] cmd [15:8] arg；0x01 抓取 0x02 释放 0x03 预张 0x10 回中
+REG_TARGET0 = 0x10  # +i*4: [11:0] 角度0.1° [15:12] 舵机ID
+REG_TORQUE_LIM = 0x30  # 每 4 位一通道 0..15
+REG_TIMING = 0x34  # [7:0] 闭合速度 [15:8] 轮询周期(×0.1ms)
+REG_STATUS = 0x80  # [0] busy [1] grasped [2] timeout [3] fault
+REG_FSM_STATE = 0x84
+REG_MEAS0 = 0x90  # +i*4: [11:0] 角度 [15:12] 标志
+REG_LOAD0 = 0xB0  # +i*2: 16 位半字 ×8（跨 32 位字对齐）
+REG_TEMP = 0xD0
+REG_ERR_BITMAP = 0xE0
+REG_TIMESTAMP = 0xF0
+
+DEFAULT_AXI_BASE = 0x4000_0000
+_PAGE_SIZE = 4096
+
+
+class AxilRegs:
+    """AXI4-Lite 从接口的 /dev/mem 访问器（32bit 读写）。"""
+
+    def __init__(self, base_addr: int = DEFAULT_AXI_BASE):
+        self._base = base_addr
+        self._map = None
+        self._fd = None
+
+    def open(self) -> None:
+        import mmap
+        import os
+
+        self._fd = os.open("/dev/mem", os.O_RDWR | os.O_SYNC)
+        page = self._base & ~(_PAGE_SIZE - 1)
+        offset = self._base - page
+        self._map = mmap.mmap(self._fd, _PAGE_SIZE, mmap.MAP_SHARED,
+                              mmap.PROT_READ | mmap.PROT_WRITE, offset=offset)
+
+    def close(self) -> None:
+        if self._map is not None:
+            self._map.close()
+            self._map = None
+        if self._fd is not None:
+            import os
+
+            os.close(self._fd)
+            self._fd = None
+
+    def read32(self, offset: int) -> int:
+        assert self._map is not None, "call open() first"
+        return int.from_bytes(self._map[offset:offset + 4], "little")
+
+    def write32(self, offset: int, value: int) -> None:
+        assert self._map is not None, "call open() first"
+        self._map[offset:offset + 4] = int(value & 0xFFFF_FFFF).to_bytes(4, "little")
+
+    def read16(self, offset: int) -> int:
+        """半字读：LOAD 区 0xB0+i*2 跨 32 位字，按对齐字读取后截取。"""
+        word_off = offset & ~0x3
+        shift = (offset - word_off) * 8
+        return (self.read32(word_off) >> shift) & 0xFFFF
+
+
+def enc_target(servo_id: int, angle_deg: float) -> int:
+    """TARGET_i 编码：[15:12] ID + [11:0] 角度 0.1°（编码细则=待定项 1，占位）。"""
+    deci = int(round(angle_deg * 10)) & 0xFFF
+    return ((servo_id & 0xF) << 12) | deci
+
+
+def dec_meas(word: int) -> tuple[int, int]:
+    """MEAS_i 解码 → (位置 0.1°, 标志)。"""
+    return word & 0xFFF, (word >> 12) & 0xF
+
+
+class FpgaBackend(ServoBackend):
+    name = "fpga"
+
+    def __init__(self, axi_base: int = DEFAULT_AXI_BASE,
+                 servo_ids: Iterable[int] = range(1, 9),
+                 poll_period_units: int = 10):  # 10×0.1ms = 1kHz（interface.md §6）
+        self._regs = AxilRegs(axi_base)
+        self._ids = tuple(servo_ids)
+        self._poll_units = poll_period_units
+
+    def open(self) -> None:
+        self._regs.open()
+        # TIMING：轮询周期 1kHz 默认；闭合速度由 GraspPlan 逐次下发
+        self._regs.write32(REG_TIMING, (self._poll_units & 0xFF) << 8)
+
+    def close(self) -> None:
+        self.emergency_stop()
+        self._regs.close()
+
+    # -- ServoBackend 接口 ----------------------------------------------
+
+    def set_torque(self, on: bool) -> None:
+        # CMD=0x04 力矩使能（arg 1=使能 0=断开）——interface.md §3 CMD 扩展，v0.2.1 起生效
+        self._regs.write32(REG_CMD, ((0x01 if on else 0x00) << 8) | 0x04)
+
+    def set_targets(self, angles_deg: tuple[float, ...], speed_raw: int = 0) -> None:
+        # 直接角度模式：CTRL.mode=0
+        ctrl = self._regs.read32(REG_CTRL)
+        self._regs.write32(REG_CTRL, (ctrl & ~0x2) | 0x1)
+        for i, sid in enumerate(self._ids):
+            self._regs.write32(REG_TARGET0 + i * 4, enc_target(sid, angles_deg[i]))
+        self._regs.write32(REG_TIMING, ((self._poll_units & 0xFF) << 8) | (speed_raw & 0xFF))
+
+    def start_grasp_fsm(self, plan: GraspPlan) -> None:
+        # 状态机模式：写目标/力矩/时序 → CTRL.mode=1 → CMD=0x01
+        for i, sid in enumerate(self._ids):
+            self._regs.write32(REG_TARGET0 + i * 4, enc_target(sid, plan.angles_deg[i]))
+        torque_word = 0
+        for i in range(N_JOINTS):
+            torque_word |= (plan.torque_levels[i] & 0xF) << (4 * i)
+        self._regs.write32(REG_TORQUE_LIM, torque_word)
+        self._regs.write32(REG_TIMING,
+                           ((self._poll_units & 0xFF) << 8) | (plan.speed_raw & 0xFF))
+        ctrl = self._regs.read32(REG_CTRL)
+        self._regs.write32(REG_CTRL, ctrl | 0x2 | 0x1)  # mode=1, enable=1
+        self._regs.write32(REG_CMD, 0x01)
+
+    def release(self) -> None:
+        self._regs.write32(REG_CMD, 0x02)
+
+    def emergency_stop(self) -> None:
+        ctrl = self._regs.read32(REG_CTRL)
+        self._regs.write32(REG_CTRL, ctrl | 0x4)  # estop=1
+
+    def poll_fsm(self) -> FsmSnapshot:
+        status = self._regs.read32(REG_STATUS)
+        feedback = self._read_feedback()
+        return FsmSnapshot(
+            state=FsmState(self._regs.read32(REG_FSM_STATE) & 0xFF),
+            busy=bool(status & 0x1),
+            grasped=bool(status & 0x2),
+            timeout=bool(status & 0x4),
+            fault=bool(status & 0x8),
+            err_bitmap=self._regs.read32(REG_ERR_BITMAP),
+            loop_timestamp=self._regs.read32(REG_TIMESTAMP),
+            feedback=feedback,
+        )
+
+    def read_loop_timestamp(self) -> int:
+        return self._regs.read32(REG_TIMESTAMP)
+
+    def _read_feedback(self) -> list[ServoFeedback]:
+        temp_word = self._regs.read32(REG_TEMP)
+        feedback: list[ServoFeedback] = []
+        for i, sid in enumerate(self._ids):
+            pos_deci, flags = dec_meas(self._regs.read32(REG_MEAS0 + i * 4))
+            online = not (flags & 0x1)  # 标志位布局与 PL 约定：bit0=offline（待定稿）
+            feedback.append(ServoFeedback(
+                servo_id=sid,
+                online=online,
+                position_raw=pos_deci,  # 占位：0.1°→raw 换算属待定项 1，联调时统一
+                position_deg=pos_deci * 0.1,
+                load_raw=self._regs.read16(REG_LOAD0 + i * 2),
+                temperature_c=float((temp_word >> 8) & 0xFF) if i == (temp_word & 0xFF) else 0.0,
+                voltage_x10=0,
+                error_bits=flags,
+            ))
+        return feedback
diff --git a/host/app/control/backend_serial.py b/host/app/control/backend_serial.py
new file mode 100644
index 0000000000000000000000000000000000000000..16f0b003b8cd8fb5da39e4287cf66ce2c03cbf60
--- /dev/null
+++ b/host/app/control/backend_serial.py
@@ -0,0 +1,184 @@
+"""软件环后端 —— USB-TTL 直驱舵机总线（F5 对比实验的基准环）。
+
+- 通道：Waveshare 总线驱动板（PS USB3.0 → /dev/ttyUSB0），1Mbps 半双工；
+- 协议：``scs_protocol`` 组包/解包（与 sim/fpga 后端同一份 golden model）；
+- 状态机：与 backend_sim 相同逻辑的软件实现（Python 循环）——
+  这正是对比实验的意义：**同一状态机，Python 环 vs RTL 环**，
+  ``read_loop_timestamp`` 用 ``time.perf_counter_ns()`` 供抖动统计；
+- 板端运行（Linux, aarch64）；PC 上构造会被拒绝（防止误插真实硬件之外的场景）。
+"""
+
+from __future__ import annotations
+
+import math
+import time
+from typing import Iterable
+
+from app.control import scs_protocol as sp
+from app.control.servo_base import (
+    N_JOINTS,
+    FsmState,
+    FsmSnapshot,
+    GraspPlan,
+    ServoBackend,
+    ServoFeedback,
+)
+
+#: 关节角（度，相对中位）→ raw：真实换算依赖待定项 1 标定，先按几何满量程占位
+ANGLE_RANGE_DEG = 180.0  # TODO(实机校验)：MiddlePos ± 行程，标定后出 servo_map
+
+
+def deg_to_raw(deg: float, middle_deg: float) -> int:
+    """占位换算：-ANGLE_RANGE..+ANGLE_RANGE → 0..4095。真值表待标定替换。"""
+    frac = (deg + middle_deg + ANGLE_RANGE_DEG) / (2 * ANGLE_RANGE_DEG)
+    return max(0, min(sp.POSITION_STEPS, int(round(frac * sp.POSITION_STEPS))))
+
+
+class SerialBackend(ServoBackend):
+    name = "serial"
+
+    def __init__(self, port: str = "/dev/ttyUSB0", baudrate: int = 1_000_000,
+                 timeout_s: float = 0.05, middle_deg: Iterable[float] = (0.0,) * N_JOINTS,
+                 servo_ids: Iterable[int] = range(1, 9)):
+        self._port_cfg = port
+        self._baud = baudrate
+        self._timeout_s = timeout_s
+        self.middle = tuple(middle_deg)
+        self._ids = tuple(servo_ids)
+        self._ser: object | None = None  # serial.Serial（延迟导入）
+        # 软件状态机状态（与 backend_sim 逻辑一致，逐段对照）
+        self._fsm: FsmState = FsmState.IDLE
+        self._plan: GraspPlan | None = None
+        self._state_t: float = 0.0
+
+    # -- 串口基础 -------------------------------------------------------
+
+    def open(self) -> None:
+        try:
+            import serial  # pyserial：仅真实后端需要
+        except ImportError as exc:  # pragma: no cover
+            raise RuntimeError("backend_serial 需要 pyserial（pip install pyserial）") from exc
+        self._ser = serial.Serial(self._port_cfg, self._baud, timeout=self._timeout_s)
+
+    def close(self) -> None:
+        if self._ser is not None:
+            try:
+                self.set_torque(False)
+            finally:
+                self._ser.close()
+                self._ser = None
+
+    def _transact(self, frame: bytes, expect_reply: bool) -> sp.Response | None:
+        """写请求帧，读一帧响应（半双工：发完才收）。"""
+        assert self._ser is not None
+        self._ser.write(frame)
+        self._ser.flush()
+        if not expect_reply:
+            return None
+        deadline = time.perf_counter() + self._timeout_s
+        buf = bytearray()
+        while time.perf_counter() < deadline:
+            n = self._ser.in_waiting
+            if n:
+                buf += self._ser.read(n)
+                try:
+                    return sp.parse_response(bytes(buf))
+                except sp.ProtocolError:
+                    continue  # 半帧/坏帧：继续凑字节
+        return None
+
+    # -- ServoBackend 接口 ----------------------------------------------
+
+    def set_torque(self, on: bool) -> None:
+        for sid in self._ids:
+            self._transact(sp.build_write(sid, sp.Reg.TORQUE_SWITCH[0], bytes([1 if on else 0])), True)
+
+    def set_targets(self, angles_deg: tuple[float, ...], speed_raw: int = 0) -> None:
+        for i, sid in enumerate(self._ids):
+            raw = deg_to_raw(angles_deg[i], self.middle[i])
+            self._transact(sp.build_write_u16(sid, sp.Reg.GOAL_POSITION[0], raw), True)
+            self._transact(sp.build_write_u16(sid, sp.Reg.RUNNING_SPEED[0], speed_raw), True)
+
+    def start_grasp_fsm(self, plan: GraspPlan) -> None:
+        self._plan = plan
+        self._fsm = FsmState.PREGRASP
+        self._state_t = 0.0
+        self.set_torque(True)
+        self.set_targets(plan.pregrasp_deg, plan.speed_raw)
+
+    def release(self) -> None:
+        if self._plan is not None and self._fsm in (FsmState.CLOSING, FsmState.HOLD):
+            self._fsm = FsmState.RELEASING
+            self._state_t = 0.0
+            assert self._plan is not None
+            self.set_targets(self._plan.pregrasp_deg, self._plan.speed_raw)
+
+    def emergency_stop(self) -> None:
+        self._fsm = FsmState.PROTECT
+        self._plan = None
+        self.set_torque(False)
+
+    def poll_fsm(self) -> FsmSnapshot:
+        feedback = self._read_feedback()
+        err_bitmap = 0
+        for i, fb in enumerate(feedback):
+            if not fb.online:
+                err_bitmap |= 1 << (i * 3 + 1)
+            elif fb.error_bits & sp.ERR_OVERLOAD:
+                err_bitmap |= 1 << (i * 3)
+            elif fb.error_bits & sp.ERR_OVERHEAT:
+                err_bitmap |= 1 << (i * 3 + 2)
+        return FsmSnapshot(
+            state=self._fsm,
+            busy=self._fsm not in (FsmState.IDLE, FsmState.HOLD),
+            grasped=self._fsm == FsmState.HOLD,
+            fault=self._fsm == FsmState.PROTECT,
+            err_bitmap=err_bitmap,
+            loop_timestamp=self.read_loop_timestamp(),
+            feedback=feedback,
+        )
+
+    def read_loop_timestamp(self) -> int:
+        return time.perf_counter_ns()
+
+    def tick(self, dt_s: float) -> None:
+        """软件环：状态机在 Python 循环里推进（与 RTL 环对比的核心差异）。"""
+        self._state_t += dt_s
+        plan = self._plan
+        if plan is None:
+            return
+        if self._fsm == FsmState.PREGRASP and self._state_t >= 0.3:
+            self.set_targets(plan.angles_deg, plan.speed_raw)
+            self._fsm, self._state_t = FsmState.CLOSING, 0.0
+        elif self._fsm == FsmState.CLOSING:
+            fb = self._read_feedback()
+            hit = any(
+                f.online and f.load_raw >= plan.torque_levels[i] * 64
+                for i, f in enumerate(fb)
+            )
+            if hit or self._state_t >= 3.0:
+                self._fsm, self._state_t = FsmState.HOLD, 0.0
+        elif self._fsm == FsmState.RELEASING and self._state_t >= 0.5:
+            self._fsm, self._plan = FsmState.IDLE, None
+
+    def _read_feedback(self) -> list[ServoFeedback]:
+        out: list[ServoFeedback] = []
+        for i, sid in enumerate(self._ids):
+            fb = ServoFeedback(servo_id=sid, online=False)
+            resp = self._transact(
+                sp.build_read(sid, sp.Reg.FEEDBACK_ADDR, sp.Reg.FEEDBACK_LEN), True
+            )
+            if resp is not None and len(resp.params) == sp.Reg.FEEDBACK_LEN:
+                pos_raw = resp.param_u16(0)
+                fb = ServoFeedback(
+                    servo_id=sid,
+                    online=True,
+                    position_raw=pos_raw,
+                    position_deg=sp.raw_to_rad(pos_raw) * 180.0 / math.pi - self.middle[i],
+                    load_raw=resp.param_u16(4),
+                    temperature_c=float(resp.params[7]),
+                    voltage_x10=resp.params[6],
+                    error_bits=resp.error,
+                )
+            out.append(fb)
+        return out
diff --git a/host/app/control/backend_sim.py b/host/app/control/backend_sim.py
new file mode 100644
index 0000000000000000000000000000000000000000..10d954eae6f163b197dd5de3acb3babf4e598b83
--- /dev/null
+++ b/host/app/control/backend_sim.py
@@ -0,0 +1,242 @@
+"""模拟后端 —— VirtualServoBus + 软件版抓取状态机。
+
+双重身份
+========
+1. PC 冒烟/全链路空转的默认后端（``settings.yaml: backend: sim``）；
+2. **RTL grasp_fsm.sv 的行为 golden model**：内置的软件状态机
+   （PREGRASP→CLOSING→HOLD→RELEASING→PROTECT）与状态迁移条件
+   （到位/力矩阈值/超时/故障）必须与未来 RTL 实现逐拍对照——
+   ``fpga/sim/tb_grasp_fsm.sv`` 将以同一 GraspPlan + 同一故障注入序列
+   比对状态轨迹。
+
+物理换算（均为 SIM/占位，真值待标定，见 interface.md 待定项 1/2）：
+- 关节角：deg（相对中位）→ raw 走 scs_protocol.rad_to_raw；
+- 力矩等级 0..15 → 负载阈值 raw = level * 64（占位线性映射）。
+"""
+
+from __future__ import annotations
+
+import math
+from typing import Iterable
+
+from app.control import scs_protocol as sp
+from app.control import scs_sim
+from app.control.servo_base import (
+    N_JOINTS,
+    FsmState,
+    FsmSnapshot,
+    GraspPlan,
+    ServoBackend,
+    ServoFeedback,
+)
+
+#: 力矩等级 → 负载阈值 raw 的占位映射（TODO 实机校验，interface.md 待定项 2）
+TORQUE_LEVEL_STEP = 64
+#: CLOSING 态力控判定的最小闭合时长（秒），避免瞬时负载误触发
+MIN_CLOSING_S = 0.05
+#: CLOSING 态超时（秒）：到时仍未保持 → timeout 置位进 HOLD/FAULT
+CLOSING_TIMEOUT_S = 3.0
+#: RELEASING 时长（秒）
+RELEASING_S = 0.5
+#: PREGRASP 时长（秒）
+PREGRASP_S = 0.3
+
+
+def deg_to_raw(deg: float, middle_deg: float) -> int:
+    """关节角（相对中位，度）→ 舵机位置 raw。"""
+    return sp.rad_to_raw(math.radians(middle_deg + deg))
+
+
+def torque_level_to_raw(level: int) -> int:
+    return level * TORQUE_LEVEL_STEP
+
+
+class SimBackend(ServoBackend):
+    """挂 VirtualServoBus 的全功能模拟后端。测试可访问 ``.bus`` 注入故障。"""
+
+    name = "sim"
+
+    def __init__(self, middle_deg: Iterable[float] = (0.0,) * N_JOINTS,
+                 servo_ids: Iterable[int] = range(1, 9)):
+        self.middle = tuple(middle_deg)
+        if len(self.middle) != N_JOINTS:
+            raise ValueError("middle_deg must have 8 entries")
+        self.bus = scs_sim.VirtualServoBus(servo_ids)
+        self._virtual_clock_us = 0
+        self._fsm: FsmState = FsmState.IDLE
+        self._plan: GraspPlan | None = None
+        self._state_t: float = 0.0  # 当前态已持续时间
+        self._closing_hold_raw: tuple[int, ...] | None = None
+        self._closed_by_timeout: bool = False  # CLOSING 超时进入 HOLD（未达力阈值/未到位）
+
+    # ------------------------------------------------------------------
+    # 生命周期
+    # ------------------------------------------------------------------
+
+    def open(self) -> None:
+        self._virtual_clock_us = 0
+
+    def close(self) -> None:
+        self.set_torque(False)
+
+    # ------------------------------------------------------------------
+    # ServoBackend 接口
+    # ------------------------------------------------------------------
+
+    def set_torque(self, on: bool) -> None:
+        for sid in self.bus.servo_ids:
+            self.bus.transact(sp.build_write(sid, sp.Reg.TORQUE_SWITCH[0], bytes([1 if on else 0])))
+
+    def set_targets(self, angles_deg: tuple[float, ...], speed_raw: int = 0) -> None:
+        """直接角度模式：SYNC_WRITE 一帧下发 8 关节。
+
+        数据布局 = 0x2A 起连写 6B：位置(2B) + Goal_Time(2B, 0=速度模式) + 速度(2B)。
+        """
+        table = {
+            sid: bytes([
+                deg_to_raw(angles_deg[i], self.middle[i]) & 0xFF,
+                (deg_to_raw(angles_deg[i], self.middle[i]) >> 8) & 0xFF,
+                0x00, 0x00,  # Goal_Time = 0：使用速度限制（不用时间模式）
+                speed_raw & 0xFF,
+                (speed_raw >> 8) & 0xFF,
+            ])
+            for i, sid in enumerate(self.bus.servo_ids)
+        }
+        self.bus.transact(sp.build_sync_write(sp.Reg.GOAL_POSITION[0], 6, table))
+
+    def start_grasp_fsm(self, plan: GraspPlan) -> None:
+        """CMD=0x01：进入 PREGRASP，随后硬件（此处软件）执行闭合。"""
+        self._plan = plan
+        self._enter(FsmState.PREGRASP)
+
+    def release(self) -> None:
+        """CMD=0x02：RELEASING → 张开至预张位 → IDLE。"""
+        if self._fsm in (FsmState.HOLD, FsmState.CLOSING):
+            self._enter(FsmState.RELEASING)
+
+    def emergency_stop(self) -> None:
+        self._enter(FsmState.PROTECT)
+
+    def poll_fsm(self) -> FsmSnapshot:
+        feedback = self._read_feedback()
+        err_bitmap = 0
+        for i, fb in enumerate(feedback):
+            if not fb.online:
+                err_bitmap |= 1 << (i * 3 + 1)  # 通道 i 掉线位（布局见 interface.md §3）
+            elif fb.error_bits & sp.ERR_OVERLOAD:
+                err_bitmap |= 1 << (i * 3)
+            elif fb.error_bits & sp.ERR_OVERHEAT:
+                err_bitmap |= 1 << (i * 3 + 2)
+        grasped = self._fsm == FsmState.HOLD and self._plan is not None and not self._closed_by_timeout
+        timeout = self._closed_by_timeout
+        return FsmSnapshot(
+            state=self._fsm,
+            busy=self._fsm not in (FsmState.IDLE, FsmState.HOLD),
+            grasped=grasped,
+            timeout=timeout,
+            fault=self._fsm == FsmState.PROTECT,
+            err_bitmap=err_bitmap,
+            loop_timestamp=self.read_loop_timestamp(),
+            feedback=feedback,
+        )
+
+    def read_loop_timestamp(self) -> int:
+        return self._virtual_clock_us
+
+    # ------------------------------------------------------------------
+    # 时间推进 + 软件状态机（RTL grasp_fsm.sv 的行为对照）
+    # ------------------------------------------------------------------
+
+    def tick(self, dt_s: float) -> None:
+        self._virtual_clock_us += int(round(dt_s * 1e6))
+        self.bus.step(dt_s)
+        self._state_t += dt_s
+        self._run_fsm(dt_s)
+
+    def _enter(self, state: FsmState) -> None:
+        self._fsm = state
+        self._state_t = 0.0
+        if state == FsmState.PREGRASP:
+            self._closed_by_timeout = False
+        if state == FsmState.PREGRASP and self._plan is not None:
+            self.set_torque(True)
+            self.set_targets(self._plan.pregrasp_deg, self._plan.speed_raw)
+        elif state == FsmState.RELEASING and self._plan is not None:
+            self.set_targets(self._plan.pregrasp_deg, self._plan.speed_raw)
+        elif state == FsmState.PROTECT:
+            self.set_torque(False)
+            self._plan = None
+            self._closing_hold_raw = None
+
+    def _run_fsm(self, dt_s: float) -> None:
+        plan = self._plan
+        if self._fsm == FsmState.PREGRASP:
+            if self._state_t >= PREGRASP_S:
+                assert plan is not None
+                self.set_targets(plan.angles_deg, plan.speed_raw)
+                self._enter(FsmState.CLOSING)
+
+        elif self._fsm == FsmState.CLOSING:
+            assert plan is not None
+            # 力控判定：任一通道负载达到其力矩阈值 → 停止并保持当前位
+            fb = self._read_feedback()
+            hit = any(
+                f.online and f.load_raw >= torque_level_to_raw(plan.torque_levels[i])
+                for i, f in enumerate(fb)
+            )
+            reached = all(
+                abs(deg_to_raw(plan.angles_deg[i], self.middle[i]) - f.position_raw) <= 4
+                for i, f in enumerate(fb)
+                if f.online
+            )
+            if hit or reached:
+                self._closed_by_timeout = False
+                self._closing_hold_raw = tuple(f.position_raw for f in fb)
+                self._enter(FsmState.HOLD)
+            elif self._state_t >= CLOSING_TIMEOUT_S:
+                self._closed_by_timeout = True
+                self._closing_hold_raw = tuple(f.position_raw for f in fb)
+                self._enter(FsmState.HOLD)  # 超时同样停止（快照 timeout=True 区分）
+
+        elif self._fsm == FsmState.HOLD:
+            # 保持：持续重申当前锁定位置（真实 RTL 以寄存器保持，软件环需重发）
+            if self._closing_hold_raw:
+                table = {
+                    sid: bytes([r & 0xFF, (r >> 8) & 0xFF, 0x00, 0x00, 0xFF, 0xFF])
+                    for sid, r in zip(self.bus.servo_ids, self._closing_hold_raw)
+                }
+                self.bus.transact(sp.build_sync_write(sp.Reg.GOAL_POSITION[0], 6, table))
+            # 保护迁移：堵转/超温/掉线 → PROTECT
+            fb = self._read_feedback()
+            if any(not f.online for f in fb) or any(
+                f.error_bits & (sp.ERR_OVERHEAT | sp.ERR_OVERLOAD) for f in fb
+            ):
+                self._enter(FsmState.PROTECT)
+
+        elif self._fsm == FsmState.RELEASING:
+            if self._state_t >= RELEASING_S:
+                self._plan = None
+                self._closing_hold_raw = None
+                self._enter(FsmState.IDLE)
+
+    # ------------------------------------------------------------------
+    # 反馈
+    # ------------------------------------------------------------------
+
+    def _read_feedback(self) -> list[ServoFeedback]:
+        out: list[ServoFeedback] = []
+        for i, sid in enumerate(self.bus.servo_ids):
+            s = self.bus.state(sid)
+            online = not s.dropped
+            pos_raw = s.position_raw if online else 0
+            out.append(ServoFeedback(
+                servo_id=sid,
+                online=online,
+                position_raw=pos_raw,
+                position_deg=sp.raw_to_rad(pos_raw) * 180.0 / math.pi - self.middle[i],
+                load_raw=s.load_raw if online else 0,
+                temperature_c=s.temperature_c if online else 0.0,
+                voltage_x10=s.voltage_x10 if online else 0,
+                error_bits=s.error_bits if online else 0,
+            ))
+        return out
