diff --git a/fpga/sim/scs_slave_model.sv b/fpga/sim/scs_slave_model.sv
new file mode 100644
index 0000000000000000000000000000000000000000..21db487418f58241c0f236fac71bb92430885d23
--- /dev/null
+++ b/fpga/sim/scs_slave_model.sv
@@ -0,0 +1,172 @@
+// ============================================================================
+// scs_slave_model.sv — 虚拟 SCS0009 从机（TB 字节级，对照 host/app/control/scs_sim.py）
+//
+// 简化决策（TB 设计）：本模型工作在**字节级**——直接挂 scs_protocol_tx/rx 的
+// 字节流接口，不模拟 UART 位时序。位层（half_duplex_uart 的 1Mbps 定时/过采样）
+// 由板端 xsim 或 ILA 实测覆盖。这样 TB 聚焦验证：协议组包/解析、时隙调度、
+// 状态机迁移——与 Python golden model 逐行为对照。
+//
+// 行为对照 scs_sim.VirtualServoBus.transact：
+//   PING 单播 → ACK；READ → 8B 反馈帧；WRITE 0x28/0x2A(6B)/0x2E → 寄存器更新；
+//   SYNC_WRITE → 逐 id 更新（per 任意，连写视图）；广播 → 不响应；
+//   drop_mask[id] → 该舵机静默（掉线注入）；load_inject[i] → 回读负载。
+//   pos 动力学：pos 每拍向 goal 逼近 1 步（TB 无需真实电机时间常数）。
+// ============================================================================
+`default_nettype none
+
+module scs_slave_model (
+    input  wire        clk,
+    input  wire        rst_n,
+    // 主机字节流（来自 scs_protocol_tx）
+    input  wire        tx_byte_valid,
+    input  wire [7:0]  tx_byte_data,
+    // 从机响应字节流（接 scs_protocol_rx）
+    output logic       rx_byte_valid,
+    output logic [7:0] rx_byte_data,
+    // 测试控制
+    input  wire [15:0] load_inject [8],  // 负载注入（模拟夹持阻力）
+    input  wire [7:0]  drop_mask         // 掉线注入（bit0..7 = 舵机1..8）
+);
+    // ---- 内部状态（8 舵机）----
+    logic [11:0] goal    [8];
+    logic [11:0] pos     [8];
+    logic [7:0]  torque  [8];
+    logic [15:0] load_q  [8];
+    logic [7:0]  temp_q  [8];
+
+    // ---- 接收解析（从机视角帧解析）----
+    typedef enum logic [2:0] {W_H1, W_H2, W_ID, W_LEN, W_INS, W_PADDR, W_PDLEN, W_PARAMS, W_CS} wst_e;
+    wst_e wst;
+    logic [7:0] w_id, w_len, w_ins, w_addr, w_dlen;
+    int unsigned p_idx;
+    logic [7:0] param_q [64];
+    byte chk;
+    logic       resp_pending;
+    logic [7:0] resp_q [16];
+    int unsigned resp_len, resp_i;
+
+    always_ff @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            wst <= W_H1; p_idx <= 0; chk <= '0;
+            rx_byte_valid <= 1'b0; rx_byte_data <= '0;
+            resp_pending <= 1'b0; resp_len <= 0; resp_i <= 0;
+            for (int i = 0; i < 8; i++) begin
+                goal[i] <= 12'd2048; pos[i] <= 12'd2048;
+                torque[i] <= '0; load_q[i] <= '0; temp_q[i] <= 8'd25;
+            end
+        end else begin
+            rx_byte_valid <= 1'b0;
+            // 响应字节流泵出
+            if (resp_pending) begin
+                if (resp_i < resp_len) begin
+                    rx_byte_valid <= 1'b1;
+                    rx_byte_data  <= resp_q[resp_i];
+                    resp_i <= resp_i + 1;
+                end else begin
+                    resp_pending <= 1'b0; resp_i <= 0;
+                end
+            end
+            // pos 动力学：向 goal 逼近
+            for (int i = 0; i < 8; i++) begin
+                if (torque[i] != 0 && pos[i] != goal[i])
+                    pos[i] <= pos[i] + ((goal[i] > pos[i]) ? 1 : -1);
+            end
+
+            // 主机字节流解析
+            if (tx_byte_valid) begin
+                unique case (wst)
+                    W_H1:  wst <= (tx_byte_data == 8'hFF) ? W_H2 : W_H1;
+                    W_H2:  wst <= (tx_byte_data == 8'hFF) ? W_ID : W_H1;
+                    W_ID:  begin w_id <= tx_byte_data; chk <= tx_byte_data; wst <= W_LEN; end
+                    W_LEN: begin w_len <= tx_byte_data; chk <= chk + tx_byte_data; wst <= W_INS; end
+                    W_INS: begin w_ins <= tx_byte_data; chk <= chk + tx_byte_data; p_idx <= 0; wst <= W_PARAMS; end
+                    W_PARAMS: begin
+                        if (p_idx == 0 && w_ins == 8'h02) begin
+                            w_addr <= tx_byte_data;            // READ: 参数[0]=addr
+                        end
+                        if (p_idx == 0 && (w_ins == 8'h03 || w_ins == 8'h83)) begin
+                            w_addr <= tx_byte_data;            // WRITE/SYNC: 参数[0]=addr
+                        end else if (p_idx == 1 && w_ins == 8'h83) begin
+                            w_dlen <= tx_byte_data;            // SYNC: 参数[1]=每舵机长度
+                        end
+                        param_q[p_idx] <= tx_byte_data;
+                        chk <= chk + tx_byte_data;
+                        // 参数个数 = LEN-2；收满转 CS
+                        if (p_idx == w_len - 3) wst <= W_CS;
+                        p_idx <= p_idx + 1;
+                    end
+                    W_CS: begin
+                        wst <= W_H1;
+                        if (tx_byte_data == ~chk) begin
+                            // 校验通过 → 执行
+                            automatic logic broadcast = (w_id == 8'hFE);
+                            automatic logic dropped = 1'b0;
+                            automatic logic [3:0] uid = w_id[3:0];
+                            if (!broadcast) dropped = drop_mask[uid - 1];
+                            if (!dropped) begin
+                                unique case (w_ins)
+                                    8'h02: begin  // READ addr len → 响应
+                                        if (!broadcast) begin
+                                            // 组响应帧：FF FF ID 0A ERR D0..D7 CS
+                                            resp_q[0] <= 8'hFF; resp_q[1] <= 8'hFF;
+                                            resp_q[2] <= w_id; resp_q[3] <= 8'h0A;
+                                            resp_q[4] <= 8'h00;
+                                            resp_q[5] <= pos[uid-1][7:0];
+                                            resp_q[6] <= {4'd0, pos[uid-1][11:8]};
+                                            resp_q[7] <= 8'd0; resp_q[8] <= 8'd0;
+                                            resp_q[9] <= load_q[uid-1][7:0];
+                                            resp_q[10] <= load_q[uid-1][15:8];
+                                            resp_q[11] <= 8'd74;
+                                            resp_q[12] <= temp_q[uid-1];
+                                            resp_q[13] <= ~(w_id + 8'h0A + 8'h00
+                                                          + pos[uid-1][7:0] + {4'd0, pos[uid-1][11:8]}
+                                                          + load_q[uid-1][7:0] + load_q[uid-1][15:8]
+                                                          + 8'd74 + temp_q[uid-1]);
+                                            resp_len <= 14; resp_i <= 0; resp_pending <= 1'b1;
+                                        end
+                                    end
+                                    8'h03: begin  // WRITE（单播/广播）
+                                        if (w_addr == 8'h28) torque[uid-1] <= param_q[1];
+                                        else if (w_addr == 8'h2A) begin
+                                            goal[uid-1] <= {param_q[2][3:0], param_q[1]};
+                                            if (w_len >= 7) goal[uid-1] <= {param_q[2][3:0], param_q[1]};
+                                        end
+                                        else if (w_addr == 8'h2E) ;
+                                        // 广播 WRITE 不响应；单播 ACK（status_return_level=2）
+                                        if (!broadcast) begin
+                                            resp_q[0] <= 8'hFF; resp_q[1] <= 8'hFF;
+                                            resp_q[2] <= w_id; resp_q[3] <= 8'h02;
+                                            resp_q[4] <= 8'h00;
+                                            resp_q[5] <= ~(w_id + 8'h02 + 8'h00);
+                                            resp_len <= 6; resp_i <= 0; resp_pending <= 1'b1;
+                                        end
+                                    end
+                                    8'h83: begin  // SYNC_WRITE：逐 (id, data) 更新
+                                        for (int s = 0; s < 8; s++) begin
+                                            automatic int unsigned base = 2 + s * (w_dlen + 1);
+                                            if (base + w_dlen < 64 && param_q[base] != 0) begin
+                                                automatic logic [3:0] sid = param_q[base][3:0];
+                                                if (w_addr == 8'h2A && w_dlen == 2)
+                                                    goal[sid-1] <= {param_q[base+2][3:0], param_q[base+1]};
+                                                else if (w_addr == 8'h2A && w_dlen == 6)
+                                                    goal[sid-1] <= {param_q[base+2][3:0], param_q[base+1]};
+                                            end
+                                        end
+                                    end
+                                    default: ;
+                                endcase
+                            end
+                        end
+                    end
+                    default: wst <= W_H1;
+                endcase
+            end
+        end
+    end
+
+    // 负载注入
+    always_ff @(posedge clk or negedge rst_n) begin
+        if (!rst_n) for (int i = 0; i < 8; i++) load_q[i] <= '0;
+        else        for (int i = 0; i < 8; i++) load_q[i] <= load_inject[i];
+    end
+endmodule
diff --git a/fpga/sim/tb_grasp_fsm.sv b/fpga/sim/tb_grasp_fsm.sv
new file mode 100644
index 0000000000000000000000000000000000000000..1ddbd072b0cc41bd1b18953880cf9499715caf12
--- /dev/null
+++ b/fpga/sim/tb_grasp_fsm.sv
@@ -0,0 +1,137 @@
+// ============================================================================
+// tb_grasp_fsm.sv — 力控状态机 TB（与 backend_sim.py golden 状态轨迹对照）
+//
+// 场景（对应 Python 测试 test_fsm_full_cycle/timeout/estop/掉线）：
+//   1. 预张快照 → CMD01 → PREGRASP(力矩事件) → 0.35s → CLOSING(速度事件)
+//   2. 负载注入超阈值 → HOLD 且 grasped=1（力控抓稳）
+//   3. CMD02 → RELEASING → IDLE
+//   4. 再次抓取，负载保持低 → 3.2s 超时 HOLD 且 timeout=1, grasped=0
+//   5. HOLD 中掉线注入 → PROTECT(fault=1) → CMD04 arg1 → IDLE
+//   6. estop 急停 → PROTECT
+// 运行：xsim/iverilog，时钟 100MHz（10ns 周期）
+// ============================================================================
+`timescale 1ns / 1ps
+`default_nettype none
+
+module tb_grasp_fsm;
+    logic clk = 0, rst_n = 0;
+    always #5 clk = ~clk;  // 100MHz
+
+    logic        cmd_valid = 0;
+    logic [7:0]  cmd_id = '0, cmd_arg = '0;
+    logic        estop = 0, enable = 1;
+    logic [95:0] target_pos = '0;
+    logic [31:0] torque_lim = 32'h6666_6666;  // 全通道 6 级（阈值 384）
+    logic [7:0]  speed_raw = 8'd3;
+    logic [15:0] meas_load [8];
+    logic [15:0] meas_pos  [8];
+    logic [7:0]  online_bitmap = 8'hFF;
+
+    logic [95:0] ctrl_target;
+    logic        torque_on, speed_event;
+    logic        evt_torque_valid;
+    logic [7:0]  evt_torque_arg;
+    logic [2:0]  fsm_state;
+    logic        fsm_busy, grasped, timeout_flag, fault;
+
+    grasp_fsm #(
+        .TICK_CYC(1_000),      // 仿真：10ms tick = 10µs（缩 1000×）
+        .PREGRASP_T(30),       // 0.3ms 仿真
+        .RELEASING_T(50),      // 0.5ms
+        .CLOSING_T(300)        // 3ms 超时
+    ) u_dut (
+        .clk(clk), .rst_n(rst_n),
+        .cmd_valid(cmd_valid), .cmd_id(cmd_id), .cmd_arg(cmd_arg),
+        .estop(estop), .enable(enable),
+        .target_pos(target_pos), .torque_lim(torque_lim), .speed_raw(speed_raw),
+        .meas_load(meas_load), .meas_pos(meas_pos), .online_bitmap(online_bitmap),
+        .ctrl_target(ctrl_target),
+        .torque_on(torque_on), .speed_event(speed_event),
+        .evt_torque_valid(evt_torque_valid), .evt_torque_arg(evt_torque_arg),
+        .fsm_state(fsm_state), .fsm_busy(fsm_busy), .grasped(grasped),
+        .timeout_flag(timeout_flag), .fault(fault)
+    );
+
+    // golden 状态编码（与 interface.md/Python FsmState 一致）
+    localparam [2:0] S_IDLE = 0, S_PREGRASP = 1, S_CLOSING = 2,
+                     S_HOLD = 3, S_RELEASING = 4, S_PROTECT = 5;
+
+    task automatic do_cmd(input [7:0] id, input [7:0] arg);
+        @(posedge clk); cmd_valid <= 1; cmd_id <= id; cmd_arg <= arg;
+        @(posedge clk); cmd_valid <= 0;
+    endtask
+
+    initial begin
+        for (int i = 0; i < 8; i++) begin
+            meas_load[i] = '0; meas_pos[i] = 12'd2048;
+        end
+        // 复位
+        repeat (10) @(posedge clk); rst_n = 1;
+        repeat (10) @(posedge clk);
+
+        // ---- 场景 1/2/3：预张快照 + 力控抓取全周期 ----
+        target_pos = {8{12'd3071}};              // 抓取目标 90°（raw 3071）
+        do_cmd(8'h03, 8'h00);                    // 预张快照（当前 TARGET 为张open? 先写张开角）
+        target_pos = {8{12'd1649}};              // 预张角 -35°（raw 1649）
+        do_cmd(8'h03, 8'h00);                    // 快照预张角
+        target_pos = {8{12'd3071}};              // 恢复抓取目标
+        do_cmd(8'h01, 8'h00);                    // 启动
+        repeat (10) @(posedge clk);
+        assert (fsm_state == S_PREGRASP) else $error("S1: expect PREGRASP, got %0d", fsm_state);
+        assert (evt_torque_valid && evt_torque_arg == 8'd1) else $error("S1: torque-on event missing");
+        // PREGRASP 0.35ms（>0.3ms 阈值）
+        repeat (35_000) @(posedge clk);
+        assert (fsm_state == S_CLOSING) else $error("S2: expect CLOSING, got %0d", fsm_state);
+        assert (speed_event) else $error("S2: speed event missing");
+
+        // 注入负载 500 ≥ 阈值 384 → 力控 HOLD
+        for (int i = 0; i < 8; i++) meas_load[i] = 16'd500;
+        repeat (1000) @(posedge clk);
+        assert (fsm_state == S_HOLD) else $error("S2: expect HOLD, got %0d", fsm_state);
+        assert (grasped && !timeout_flag) else $error("S2: grasped=%b timeout=%b", grasped, timeout_flag);
+
+        // 释放 → IDLE
+        do_cmd(8'h02, 8'h00);
+        repeat (60_000) @(posedge clk);  // 0.6ms > RELEASING 0.5ms
+        assert (fsm_state == S_IDLE) else $error("S3: expect IDLE, got %0d", fsm_state);
+        for (int i = 0; i < 8; i++) meas_load[i] = '0;
+
+        // ---- 场景 4：无负载 → 超时 HOLD（timeout=1, grasped=0）----
+        do_cmd(8'h01, 8'h00);
+        repeat (340_000) @(posedge clk);  // 3.4ms > PREGRASP+CLOSING 3.3ms
+        assert (fsm_state == S_HOLD) else $error("S4: expect HOLD, got %0d", fsm_state);
+        assert (timeout_flag && !grasped) else $error("S4: timeout=%b grasped=%b", timeout_flag, grasped);
+        do_cmd(8'h02, 8'h00);
+        repeat (600_000) @(posedge clk);
+
+        // ---- 场景 5：HOLD 掉线 → PROTECT → 手动复位 ----
+        do_cmd(8'h01, 8'h00);
+        for (int i = 0; i < 8; i++) meas_load[i] = 16'd500;
+        repeat (1000) @(posedge clk);
+        assert (fsm_state == S_HOLD) else $error("S5a");
+        online_bitmap = 8'b1011_1111;  // 舵机 6 掉线
+        repeat (100) @(posedge clk);
+        assert (fsm_state == S_PROTECT && fault) else $error("S5b: expect PROTECT");
+        assert (!torque_on) else $error("S5b: torque must be cut");
+        online_bitmap = 8'hFF;
+        do_cmd(8'h04, 8'h01);          // 手动复位
+        repeat (100) @(posedge clk);
+        assert (fsm_state == S_IDLE) else $error("S5c: expect IDLE");
+
+        // ---- 场景 6：estop ----
+        do_cmd(8'h01, 8'h00);
+        repeat (1000) @(posedge clk);
+        estop = 1; repeat (100) @(posedge clk);
+        assert (fsm_state == S_PROTECT && fault) else $error("S6: estop → PROTECT");
+        estop = 0;
+
+        $display("tb_grasp_fsm: ALL PASS");
+        $finish;
+    end
+
+    initial begin
+        #5_000_000;  // 5ms 仿真看门狗（超时场景 3.4ms）
+        $error("watchdog timeout");
+        $finish;
+    end
+endmodule
diff --git a/fpga/sim/tb_servo_bus.sv b/fpga/sim/tb_servo_bus.sv
new file mode 100644
index 0000000000000000000000000000000000000000..66c6b6b1a7e8beeb2e924954b2a27187eacedde7
--- /dev/null
+++ b/fpga/sim/tb_servo_bus.sv
@@ -0,0 +1,189 @@
+// ============================================================================
+// tb_servo_bus.sv — 1kHz 时隙调度 + 协议帧 TB（字节级，golden 对照）
+//
+// 验证项（对照 interface.md §6 预算表与 scs_protocol.py golden）：
+//   1. 时隙 t0：SYNC_WRITE 32B 帧逐字节断言
+//      FF FF FE 1C 83 2A 02 (id,pos_l,pos_h)×8 CS
+//      target=8×2048(raw 0x800) 时 CS=0xD2（手工锚点）
+//   2. t1/t2：READ 帧 FF FF ID 04 02 3A 08 B8 轮询 #1/#2，i/j 指针 +2 轮转
+//   3. slave 响应 → ctrl 回读寄存器更新（meas_pos/meas_load/temp）
+//   4. drop 注入 → online_bitmap 清位
+//   5. 事件帧：速度事件 → 广播 WRITE 0x2E
+// 运行：xsim / iverilog（字节级，无需位时序）
+// ============================================================================
+`timescale 1ns / 1ps
+`default_nettype none
+
+module tb_servo_bus;
+    logic clk = 0, rst_n = 0;
+    always #5 clk = ~clk;
+
+    // ---- ctrl 寄存器面 ----
+    logic [95:0] target_pos = {8{12'd2048}};   // 全 2048（0x800）
+    logic [31:0] torque_lim = 32'h6666_6666;
+    logic [7:0]  speed_raw  = 8'd3;
+    logic        torque_on = 0;
+    logic        speed_event = 0;
+    logic        evt_torque_valid = 0;
+    logic [7:0]  evt_torque_arg = 0;
+
+    logic [15:0] meas_pos [8];
+    logic [15:0] meas_load [8];
+    logic [7:0]  meas_temp [8];
+    logic [7:0]  online_bitmap;
+    logic [31:0] loop_timestamp;
+
+    // ---- 协议/从机互连（字节级）----
+    logic        p_tx_start;
+    scs_pkg::frame_type_e p_tx_type;
+    logic [2:0]  p_tx_read_id;
+    logic [7:0]  p_tx_arg;
+    logic [95:0] p_tx_pos;
+    logic        p_tx_valid, p_tx_done, p_tx_ready;
+    logic [7:0]  p_tx_byte;
+    logic        u_rx_valid;
+    logic [7:0]  u_rx_byte;
+    logic        r_frame_done, r_frame_err;
+    logic [3:0]  r_resp_id;
+    logic [63:0] r_resp_data;
+
+    logic [15:0] load_inject [8];
+    logic [7:0]  drop_mask = 8'h00;
+
+    servo_bus_ctrl #(.SLOT_CYC(2_000), .READ_TIMEOUT_CYC(300)) u_ctrl (  // 时隙缩到 20µs 加速
+        .clk(clk), .rst_n(rst_n),
+        .tx_start(p_tx_start), .tx_type(p_tx_type), .tx_read_id(p_tx_read_id),
+        .tx_arg(p_tx_arg), .tx_pos(p_tx_pos), .tx_done(p_tx_done),
+        .rx_frame_done(r_frame_done), .rx_frame_err(r_frame_err),
+        .rx_resp_id(r_resp_id), .rx_resp_data(r_resp_data),
+        .target_pos(target_pos), .torque_lim(torque_lim), .speed_raw(speed_raw),
+        .torque_on(torque_on), .speed_event(speed_event),
+        .evt_torque_valid(evt_torque_valid), .evt_torque_arg(evt_torque_arg),
+        .meas_pos(meas_pos), .meas_load(meas_load), .meas_temp(meas_temp),
+        .online_bitmap(online_bitmap), .loop_timestamp(loop_timestamp)
+    );
+
+    scs_protocol_tx u_ptx (
+        .clk(clk), .rst_n(rst_n),
+        .start(p_tx_start), .frame_type(p_tx_type), .read_id(p_tx_read_id),
+        .arg_field(p_tx_arg), .pos_raw(p_tx_pos),
+        .byte_valid(p_tx_valid), .byte_data(p_tx_byte),
+        .byte_ready(p_tx_ready), .done(p_tx_done)
+    );
+
+    scs_protocol_rx u_prx (
+        .clk(clk), .rst_n(rst_n),
+        .byte_valid(u_rx_valid), .byte_data(u_rx_byte),
+        .frame_done(r_frame_done), .frame_err(r_frame_err),
+        .resp_id(r_resp_id), .resp_err(), .resp_data(r_resp_data)
+    );
+
+    scs_slave_model u_slave (
+        .clk(clk), .rst_n(rst_n),
+        .tx_byte_valid(p_tx_valid), .tx_byte_data(p_tx_byte),
+        .rx_byte_valid(u_rx_valid), .rx_byte_data(u_rx_byte),
+        .load_inject(load_inject), .drop_mask(drop_mask)
+    );
+
+    // p_tx_ready：字节立即被消费（tx_done 作 ready，TB 无真实 uart）
+    assign p_tx_ready = 1'b1;
+
+    // ---- 帧捕获 ----
+    logic [7:0] cap [64];
+    int unsigned cap_len;
+    int unsigned cap_cnt;
+    logic        cap_on;
+    always_ff @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            cap_len <= 0; cap_cnt <= 0; cap_on <= 0;
+        end else begin
+            if (p_tx_start) begin
+                cap_cnt <= 0; cap_len <= 0; cap_on <= 1;
+            end
+            if (cap_on && p_tx_valid) begin
+                cap[cap_cnt] <= p_tx_byte;
+                cap_cnt <= cap_cnt + 1;
+                cap_len <= cap_cnt + 1;
+                if (cap_cnt >= 63) cap_on <= 0;
+            end
+            if (p_tx_done) cap_on <= 0;
+        end
+    end
+
+    task automatic expect_byte(input int unsigned i, input byte v, input string tag);
+        assert (cap[i] == v)
+        else $error("%s: byte[%0d]=0x%02X expect 0x%02X", tag, i, cap[i], v);
+    endtask
+
+    initial begin
+        for (int i = 0; i < 8; i++) load_inject[i] = '0;
+        repeat (10) @(posedge clk); rst_n = 1;
+        // 等第一个 SYNC_WRITE 帧（时隙 0 触发）
+        wait (p_tx_done == 1'b1); @(posedge clk);
+        // ---- 断言 1：SYNC_WRITE 32B 帧结构 ----
+        expect_byte(0, 8'hFF, "sync");
+        expect_byte(1, 8'hFF, "sync");
+        expect_byte(2, 8'hFE, "sync");
+        expect_byte(3, 8'h1C, "sync");   // LEN=28
+        expect_byte(4, 8'h83, "sync");
+        expect_byte(5, 8'h2A, "sync");
+        expect_byte(6, 8'h02, "sync");
+        for (int s = 0; s < 8; s++) begin
+            expect_byte(7 + 3*s,     byte'(s + 1), "sync");
+            expect_byte(8 + 3*s,     8'h00, "sync");   // 2048 = 0x800 → low 0x00
+            expect_byte(9 + 3*s,     8'h08, "sync");   // high 0x08
+        end
+        expect_byte(31, 8'hD2, "sync");  // 手工锚点 CS
+        $display("T1 PASS: SYNC_WRITE frame (32B, CS=0xD2)");
+
+        // ---- 等 READ #1 帧 ----
+        @(posedge p_tx_start);
+        @(posedge p_tx_done); @(posedge clk);
+        expect_byte(0, 8'hFF, "read1");
+        expect_byte(1, 8'hFF, "read1");
+        expect_byte(2, 8'h01, "read1");
+        expect_byte(3, 8'h04, "read1");
+        expect_byte(4, 8'h02, "read1");
+        expect_byte(5, 8'h3A, "read1");
+        expect_byte(6, 8'h08, "read1");
+        expect_byte(7, 8'hB6, "read1");  // CS = ~0x49（01+04+02+3A+08）
+        $display("T2 PASS: READ #1 frame");
+        // slave 响应 → 回读更新
+        repeat (200) @(posedge clk);
+        assert (online_bitmap[0] == 1'b1) else $error("T3: servo1 online");
+        assert (meas_pos[0] == 16'd2048) else $error("T3: meas_pos=%0d", meas_pos[0]);
+
+        // ---- 掉线注入：舵机 1 静默 → READ 超时清 online（保持注入期间断言）----
+        drop_mask = 8'b0000_0001;
+        repeat (6_000) @(posedge clk);   // 数个时隙，超时生效
+        assert (online_bitmap[0] == 1'b0) else $error("T4: servo1 offline expected, bitmap=%02X", online_bitmap);
+        $display("T4 PASS: drop injection -> offline bit");
+        drop_mask = 8'h00;
+        repeat (4_000) @(posedge clk);   // 恢复在线
+        assert (online_bitmap[0] == 1'b1) else $error("T4b: servo1 back online");
+
+        // ---- 事件帧：速度事件 → 广播 WRITE 0x2E ----
+        speed_event <= 1'b1;
+        @(posedge clk); speed_event <= 1'b0;
+        repeat (4_000) @(posedge clk);
+        // 最近捕获帧应为广播速度帧 8B：FF FF FE 04 03 2E 03 CS
+        expect_byte(0, 8'hFF, "evt");
+        expect_byte(1, 8'hFF, "evt");
+        expect_byte(2, 8'hFE, "evt");
+        expect_byte(3, 8'h04, "evt");
+        expect_byte(4, 8'h03, "evt");
+        expect_byte(5, 8'h2E, "evt");
+        expect_byte(6, 8'h03, "evt");    // speed_raw=3
+        expect_byte(7, 8'hC9, "evt");    // CS = ~(FE+04+03+2E+03) = ~0x36 = 0xC9（golden 锚点）
+        $display("T5 PASS: speed event frame");
+
+        $display("tb_servo_bus: ALL PASS");
+        $finish;
+    end
+
+    initial begin
+        #2_000_000;  // 2ms 仿真看门狗
+        $error("watchdog timeout");
+        $finish;
+    end
+endmodule
